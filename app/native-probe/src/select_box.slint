import {AppColors} from "action_button.slint";
import {SelectPopup} from "select_popup.slint";
export component SelectBox inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index:0;
    in property <bool> enabled:true;
    in property <bool> compact:false;
    in property <bool> controlled:false;
    out property <bool> has-focus:keys.has-focus;
    property <int> ticket:-1;
    property <int> delivery:SelectPopup.committed;
    property <bool> opened:root.ticket==SelectPopup.serial&&SelectPopup.opened;
    callback popup-state(bool);
    changed opened=>{
        root.popup-state(root.opened);
        if !root.opened&&root.ticket==SelectPopup.serial&&root.enabled{keys.focus();}
    }
    changed delivery=>{if root.ticket==SelectPopup.committed{if !root.controlled{root.current-index=SelectPopup.result;}root.selected(SelectPopup.result);}}
    changed enabled=>{if !root.enabled&&root.ticket==SelectPopup.serial{SelectPopup.opened=false;}}
    public function close-popup(){if root.opened{SelectPopup.opened=false;}}
    callback selected(int);
    function choose(index:int){if index>=0&&index<root.model.length{if !root.controlled{root.current-index=index;}root.selected(index);}keys.focus();}
    function show(){if root.enabled&&root.model.length>0{
        SelectPopup.model=root.model;SelectPopup.current=root.current-index;SelectPopup.highlighted=max(0,root.current-index);
        SelectPopup.anchor-x=self.absolute-position.x;SelectPopup.anchor-y=self.absolute-position.y;
        SelectPopup.anchor-width=root.width;SelectPopup.anchor-height=root.height;
        SelectPopup.serial+=1;root.ticket=SelectPopup.serial;SelectPopup.opened=true;
    }}
    min-width:0px;preferred-width:180px;preferred-height:root.compact?30px:36px;min-height:root.compact?30px:36px;vertical-stretch:0;
    border-radius:10px;border-width:1px;border-color:AppColors.edge;
    background:root.enabled?AppColors.field:AppColors.inset;forward-focus:keys;
    animate border-color,background {duration:AppColors.motion?160ms:0ms;}
    accessible-role:combobox;accessible-enabled:root.enabled;accessible-expandable:true;accessible-expanded:root.opened;
    accessible-value:root.current-index>=0&&root.current-index<root.model.length?root.model[root.current-index]:"";
    accessible-action-expand=>{root.show();}
    Text {x:root.compact?10px:12px;width:parent.width - 42px;height:parent.height;text:root.current-index>=0&&root.current-index<root.model.length?root.model[root.current-index]:"";color:root.enabled?AppColors.ink:AppColors.muted;font-size:round((root.compact?11px:12px)/1phx)*1phx;vertical-alignment:center;overflow:elide;}
    Image {x:parent.width - 28px;y:(parent.height - 16px)/2;width:16px;height:16px;source:@image-url("icons/chevron.svg");colorize:root.enabled?AppColors.muted:AppColors.muted.with-alpha(0.45);transform-rotation:root.opened?180deg:0deg;animate transform-rotation {duration:AppColors.motion?220ms:0ms;easing:cubic-bezier(0.16,1,0.3,1);}}
    keys:=FocusScope {enabled:root.enabled;key-pressed(event)=>{
        if event.text==Key.Return||event.text==" "{root.show();return accept;}
        if event.text==Key.DownArrow{root.choose(min(root.model.length - 1,root.current-index+1));return accept;}
        if event.text==Key.UpArrow{root.choose(max(0,root.current-index - 1));return accept;}return reject;
    }}
    TouchArea {enabled:root.enabled;clicked=>{root.show();}}
}
