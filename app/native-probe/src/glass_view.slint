import {SpinBox,Slider,VerticalBox,HorizontalBox,Palette} from "std-widgets.slint";
import {SegmentedChoice} from "settings_controls.slint";
import {ActionButton,AppColors} from "action_button.slint";
// THESIS: Extend the existing native settings page with independent quality and opacity controls.
// OWN-WORLD: PortCanvas Operate surface, existing light/dark palette and native form controls.
// STORY: Keep preferred quality/opacity, show temporary system limits; suggestions require explicit choice.
// FIRST VIEWPORT: One compact group above Background; labeled quality row and numeric opacity slider.
// FORM: User-pinned local extension, code-led; reuse the native settings and existing confirmation surface.
// FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
export component GlassSettings inherits VerticalBox {
    in property <bool> english;in property <bool> enabled;
    in-out property <int> quality:2;in-out property <float> material:100;
    property <int> material-number:round(root.material);
    changed material=>{root.material-number=round(root.material);}
    in property <string> error;in property <string> notice;
    pure callback tr(string,bool)->string;callback update(bool);
    padding:0px;spacing:8px;
    HorizontalBox {padding:0px;height:42px;vertical-stretch:0;
        Text {text:root.tr("效果质量",root.english);font-size:13px;color:AppColors.ink;vertical-alignment:center;}
        SegmentedChoice {width:260px;model:[root.tr("轻量",root.english),root.tr("均衡",root.english),root.tr("完整",root.english)];current-index:root.quality;enabled:root.enabled;selected(i)=>{root.quality=i;root.update(true);}}
    }
    HorizontalBox {padding:0px;vertical-stretch:0;
        Text {text:root.tr("非透明度",root.english);font-size:13px;color:AppColors.ink;}
        Slider {value<=>root.material;minimum:0;maximum:100;step:1;enabled:root.enabled;accessible-label:root.tr("玻璃不透明度：0% 更通透，100% 更厚实",root.english);changed(_)=>{root.update(false);}released(_)=>{root.update(true);}}
        SpinBox {preferred-width:90px;min-width:80px;max-width:90px;minimum:0;maximum:100;value<=>root.material-number;enabled:root.enabled;accessible-label:root.tr("玻璃不透明度",root.english);edited(v)=>{root.material=v;root.update(true);}}
    }

    if root.notice!="":Text {text:root.tr(root.notice,root.english);color:Palette.foreground;wrap:word-wrap;vertical-stretch:0;}
    if root.error!="":Text {text:root.tr(root.error,root.english);color:Palette.foreground;font-weight:600;wrap:word-wrap;vertical-stretch:0;}
}
