import {ScrollView,ListView,VerticalBox,HorizontalBox,Palette} from "std-widgets.slint";
import {FormInput as LineEdit} from "form_input.slint";
import {ConnectionBadge} from "workbench_chrome.slint";
import {ActionButton,ActionButton as Button,ActivityIndicator,AppColors} from "action_button.slint";
import {DesktopTool} from "desktop_tool.slint";
import {CommandEditor} from "command_editor.slint";
export struct TerminalCell { column:int,row:int,text:string,ink:color,paper:color,wide:bool,bold:bool,underline:bool }
export struct TerminalTab {key:string,title:string,online:bool}
export struct CompletionRow {label:string}
export component TerminalView inherits VerticalBox {
    padding:0px;spacing:8px;
    in property <[TerminalTab]> tabs;
    in property <string> active;
    in property <[TerminalCell]> cells;
    in property <int> cursor-column;
    in property <int> cursor-row;
    in property <bool> cursor-visible:true;
    in property <string> phase;
    in property <string> status;in property <string> info;
    property <bool> metadata-open:false;
    property <bool> horizontal-lines:true;
    function reveal-cursor() {
        if input.has-focus {
            let x=8px+root.cursor-column*9px;
            if x < -terminal-scroll.viewport-x || x+9px > -terminal-scroll.viewport-x+terminal-scroll.visible-width {
                terminal-scroll.viewport-x=-max(0px,x - terminal-scroll.visible-width/2);
            }
        }
    }
    changed cursor-column=>{root.reveal-cursor();}
    in property <string> error;
    in property <string> log-status;
    in property <bool> connected;
    in property <bool> busy;
    in property <bool> sending;
    in property <bool> enabled:true;
    in property <bool> english;
    in-out property <string> draft;
    in-out property <string> project;
    in-out property <bool> expanded:false;
    in property <[CompletionRow]> completions;
    in property <int> completion-index;
    in property <bool> completion-loading;
    in property <bool> completion-truncated;
    in property <int> command-caret;
    in property <int> command-revision;
    pure callback tr(string,bool)->string;
    callback close-tab(string);callback select-tab(string);callback action(string);callback copy();callback paste();
    callback scroll(int);callback select(int,int,int,int);callback resize-grid(int,int);
    callback committed(string);callback key(string,bool,bool,bool)->bool;
    callback draft-edited(string,int);callback project-edited(string);callback send-command();
    callback editor-key(string,bool,bool,bool,bool)->bool;callback editor-focused(bool);callback choose-completion(int);
    callback connect-device();
    property <bool> live:root.connected&&root.phase=="connected"&&!root.busy&&root.enabled;
    HorizontalBox {padding:0px;spacing:8px;height:36px;vertical-stretch:0;
        ScrollView {viewport-height:36px;vertical-scrollbar-policy:always-off;horizontal-scrollbar-policy:always-off;
            HorizontalBox {padding:0px;spacing:6px;height:36px;
                for tab[index] in root.tabs:Rectangle {width:min(160px,max(100px,tab-label.preferred-width+58px));horizontal-stretch:0;height:32px;border-radius:9px;border-width:1px;border-color:tab.key==root.active?AppColors.edge:transparent;background:tab.key==root.active?AppColors.field:tab-touch.has-hover?AppColors.field:transparent;animate background {duration:AppColors.motion?150ms:0ms;}
                    Rectangle {x:10px;y:14px;width:4px;height:4px;border-radius:3px;background:tab.online?#4f9e7d:AppColors.muted.with-alpha(0.45);}
                    tab-label:=Text {x:20px;width:parent.width - 52px;height:parent.height;text:tab.title;font-size:12px;color:AppColors.ink;vertical-alignment:center;overflow:elide;}
                    tab-focus:=FocusScope {enabled:root.enabled&&!root.busy;key-pressed(event)=>{
                        if event.text==Key.Return||event.text==" "{root.select-tab(tab.key);return accept;}
                        if event.text==Key.LeftArrow{root.select-tab(root.tabs[max(0,index - 1)].key);return accept;}
                        if event.text==Key.RightArrow{root.select-tab(root.tabs[min(root.tabs.length - 1,index + 1)].key);return accept;}
                        if event.text==Key.Home{root.select-tab(root.tabs[0].key);return accept;}
                        if event.text==Key.End{root.select-tab(root.tabs[root.tabs.length - 1].key);return accept;}return reject;
                    }}
                    tab-touch:=TouchArea {width:parent.width - 30px;enabled:root.enabled&&!root.busy;clicked=>{tab-focus.focus();root.select-tab(tab.key);}}
                    DesktopTool {x:parent.width - 30px;width:30px;height:32px;show-text:false;label:root.tr("关闭终端",root.english)+" "+tab.title;icon:@image-url("icons/close.svg");enabled:root.enabled&&root.connected&&!root.busy;clicked=>{root.close-tab(tab.key);}}
                    forward-focus:tab-focus;accessible-role:button;accessible-label:tab.title;accessible-checkable:true;accessible-checked:tab.key==root.active;accessible-action-default=>{root.select-tab(tab.key);}
                }
            }
        }
        Button {text:root.tr("新建",root.english);icon:@image-url("icons/plus.svg");has-icon:true;busy:root.busy;enabled:root.connected&&!root.busy&&root.enabled;clicked=>{root.action("create");}}
    }
    property <bool> actions-open:false;
    changed enabled=>{if !root.enabled{root.actions-open=false;actions-popup.close();}}
    property <bool> completions-visible:root.completion-loading||root.completions.length>0;
    property <float> completion-phase:root.completions-visible?1:0;
    animate completion-phase {duration:AppColors.motion?140ms:0ms;}
    HorizontalBox {padding:0px;spacing:6px;height:36px;vertical-stretch:0;
        ActionButton {primary:root.phase!="connected";busy:root.phase=="connecting";text:root.tr(!root.connected?(root.width<420px?"连接":"连接设备"):root.phase=="connected"?"断开":root.phase=="connecting"?(root.width<420px?"取消":"取消连接"):(root.width<420px?"连接":"连接终端"),root.english);enabled:root.enabled&&!root.busy&&(!root.connected||root.active!="");clicked=>{if !root.connected{root.connect-device();}else{root.resize-grid(grid.columns,grid.rows);root.action(root.phase=="connected"||root.phase=="connecting"?"stop":"start");}}}
        ActionButton {text:root.tr("重启",root.english);enabled:root.connected&&!root.busy&&root.enabled&&root.active!="";clicked=>{root.action("reset");}}
        ActionButton {text:root.tr("清屏",root.english);enabled:root.enabled&&root.active!="";clicked=>{root.action("clear");}}
        Rectangle {width:root.width<420px?44px:72px;height:36px;horizontal-stretch:0;
            DesktopTool {width:parent.width;height:36px;label:root.tr("更多",root.english);show-text:root.width>=420px;text:root.tr("更多",root.english);icon:root.width<420px?@image-url("icons/more.svg"):@image-url("icons/chevron.svg");icon-angle:root.width<420px?0deg:root.actions-open?180deg:0deg;enabled:root.enabled&&root.active!="";clicked=>{root.actions-open=true;actions-popup.show();}}
            actions-popup:=PopupWindow {x:0px;y:40px;width:180px;height:156px;forward-focus:menu-keys;
                Rectangle {border-radius:13px;background:AppColors.surface;border-width:1px;border-color:AppColors.edge;drop-shadow-offset-y:6px;drop-shadow-blur:24px;drop-shadow-color:#223a661f;}
                menu-keys:=FocusScope {focus-changed-event=>{if !self.has-focus{root.actions-open=false;}}key-pressed(event)=>{if event.text==Key.Escape{actions-popup.close();root.actions-open=false;return accept;}return reject;}
                    VerticalBox {padding:6px;spacing:0px;
                        ActionButton {text:root.tr("复制选区",root.english);enabled:root.enabled;clicked=>{root.copy();actions-popup.close();root.actions-open=false;}}
                        ActionButton {text:root.tr("粘贴",root.english);enabled:root.live;clicked=>{root.paste();actions-popup.close();root.actions-open=false;}}
                        ActionButton {text:root.tr("按窗口折行",root.english);selected:!root.horizontal-lines;accessible-checkable:true;accessible-checked:!root.horizontal-lines;clicked=>{root.horizontal-lines=!root.horizontal-lines;terminal-scroll.viewport-x=0px;actions-popup.close();root.actions-open=false;}}
                        ActionButton {text:root.tr("关闭终端",root.english);enabled:root.connected&&!root.busy&&root.enabled&&root.active!="";clicked=>{root.action("remove");actions-popup.close();root.actions-open=false;}}
                    }
                }
            }
        }
    }
    DesktopTool {text:root.tr("会话信息",root.english);icon:@image-url("icons/chevron-right.svg");icon-angle:root.metadata-open?90deg:0deg;enabled:root.enabled;clicked=>{root.metadata-open=!root.metadata-open;}}
    Rectangle {height:root.metadata-open?60px:0px;vertical-stretch:0;clip:true;background:transparent;animate height {duration:AppColors.motion?260ms:0ms;easing:cubic-bezier(0.16,1,0.3,1);}Text {width:parent.width;text:root.info;color:AppColors.muted;font-size:11px;wrap:word-wrap;}}
    ConnectionBadge {width:root.width;text:root.tr(root.status,root.english);phase:root.phase=="connected"?2:root.phase=="connecting"?1:root.error!=""?3:0;}
    if root.error!="":Text {text:root.error;color:#d34b4b;wrap:word-wrap;vertical-stretch:0;}
    HorizontalBox {padding:0px;spacing:8px;height:34px;vertical-stretch:0;
        Text {text:root.tr("日志项目",root.english);color:AppColors.ink;vertical-alignment:center;horizontal-stretch:0;}
        project-input:=LineEdit {label:root.tr("日志项目",root.english);text<=>root.project;enabled:root.connected&&root.enabled;edited(value)=>{root.project-edited(value);}}
        Button {text:root.tr("保存项目",root.english);enabled:root.connected&&root.enabled&&!root.busy;clicked=>{root.action("project");}}

    }
    if root.log-status!="":Text {text:root.log-status;color:AppColors.ink;wrap:word-wrap;vertical-stretch:0;}
    Rectangle {
        min-height:120px;background:#181c24;clip:true;border-radius:13px;
        border-width:input.has-focus?2px:1px;border-color:input.has-focus?#70a5e8:#53657f;
    terminal-scroll:=ScrollView {
        x:2px;y:2px;width:parent.width - 4px;height:parent.height - (root.horizontal-lines?14px:4px);
        viewport-width:root.horizontal-lines?max(self.visible-width,240*9px+16px):self.visible-width;
        viewport-height:self.visible-height;
        horizontal-scrollbar-policy:always-off;
        vertical-scrollbar-policy:always-off;
    grid:=Rectangle {
        width:terminal-scroll.viewport-width;height:terminal-scroll.visible-height;
        background:transparent;clip:true;min-height:120px;
        property <int> columns:max(2,min(1000,floor((self.width - 16px)/9px)));
        property <int> rows:max(1,min(500,floor((self.height - 16px)/21px)));
        changed columns=>{root.resize-grid(self.columns,self.rows);}
        changed rows=>{root.resize-grid(self.columns,self.rows);}
        for cell in root.cells: Rectangle {
            x:8px+cell.column*9px;y:8px+cell.row*21px;width:cell.wide?18px:9px;height:21px;background:cell.paper;
            Text {text:cell.text;color:cell.ink;font-family:cell.wide?"Microsoft YaHei UI":"Consolas";font-size:14px;font-weight:cell.bold?700:400;vertical-alignment:center;}
            if cell.underline:Rectangle {y:19px;height:1px;background:cell.ink;}
        }
        Rectangle {visible:root.cursor-visible&&root.live&&root.cursor-row<grid.rows;
            x:8px+root.cursor-column*9px;y:8px+root.cursor-row*21px;width:9px;height:21px;border-width:1px;border-color:#d8dfeb;
        }
        touch:=TouchArea {
            property <int> start-x;property <int> start-y;
            pointer-event(event)=>{
                if event.kind==PointerEventKind.down&&event.button==PointerEventButton.left {
                    self.start-x=max(0,floor((self.mouse-x - 8px)/9px));self.start-y=max(0,floor((self.mouse-y - 8px)/21px));
                    input.focus();
                }
                if event.kind==PointerEventKind.up&&event.button==PointerEventButton.left {root.select(self.start-x,self.start-y,max(0,floor((self.mouse-x - 8px)/9px)),max(0,floor((self.mouse-y - 8px)/21px)));}
            }
            moved=>{if self.pressed {root.select(self.start-x,self.start-y,max(0,floor((self.mouse-x - 8px)/9px)),max(0,floor((self.mouse-y - 8px)/21px)));}}
            scroll-event(event)=>{if event.delta-x!=0px{return reject;}root.scroll(event.delta-y>0px?3:-3);return accept;}
        }
        // The input follows the VT cursor so system IME candidates/preedit have a real anchor.
        // Only committed edits are sent; composition updates remain inside this native item.
        input:=TextInput {
            changed has-focus=>{root.reveal-cursor();}
            x:8px+min(root.cursor-column,grid.columns - 1)*9px;y:8px+min(root.cursor-row,grid.rows - 1)*21px;
            width:max(9px,grid.width - self.x - 8px);height:21px;
            color:#d8dfeb;font-family:"Consolas";font-size:14px;single-line:true;
            accessible-label:root.tr("终端远端输入",root.english);
            enabled:root.live;
            edited=>{if self.text!=""{root.committed(self.text);self.text="";}}
            key-pressed(event)=>{
                if self.preedit-text!=""{return reject;}
                if event.modifiers.control&&event.modifiers.shift&&(event.text=="c"||event.text=="C"){root.copy();return accept;}
                if event.modifiers.control&&(event.text=="v"||event.text=="V"){root.paste();return accept;}
                if event.text==Key.Tab&&event.modifiers.control {project-input.focus();return accept;}
                if root.key(event.text,event.modifiers.control,event.modifiers.alt,event.modifiers.shift){return accept;}
                return reject;
            }
        }
    }
    }
    horizontal-track:=Rectangle {
        visible:root.horizontal-lines;x:8px;y:parent.height - 11px;width:parent.width - 16px;height:6px;
        border-radius:3px;background:#53657f55;
        property <length> travel:self.width - thumb.width;
        property <length> range:terminal-scroll.viewport-width - terminal-scroll.visible-width;
        property <length> origin;
        property <length> original-offset;
        thumb:=Rectangle {x:horizontal-track.travel*(-terminal-scroll.viewport-x)/max(1px,horizontal-track.range);width:max(32px,parent.width*terminal-scroll.visible-width/terminal-scroll.viewport-width);height:parent.height;border-radius:3px;background:scroll-touch.has-hover||scroll-touch.pressed?#a4bedf:#7089a9;}
        accessible-role:slider;accessible-label:root.tr("终端水平滚动",root.english);accessible-value:-terminal-scroll.viewport-x/1px;accessible-value-minimum:0;accessible-value-maximum:self.range/1px;
        accessible-action-increment=>{terminal-scroll.viewport-x=max(-self.range,terminal-scroll.viewport-x - 90px);}
        accessible-action-decrement=>{terminal-scroll.viewport-x=min(0px,terminal-scroll.viewport-x + 90px);}
        scroll-touch:=TouchArea {
            pointer-event(event)=>{if event.kind==PointerEventKind.down&&event.button==PointerEventButton.left{horizontal-track.origin=self.mouse-x;horizontal-track.original-offset=terminal-scroll.viewport-x;}}
            moved=>{if self.pressed{terminal-scroll.viewport-x=max(-horizontal-track.range,min(0px,horizontal-track.original-offset - (self.mouse-x - horizontal-track.origin)*horizontal-track.range/max(1px,horizontal-track.travel)));}}
            clicked=>{terminal-scroll.viewport-x=-horizontal-track.range*max(0,min(1,(self.mouse-x - thumb.width/2)/max(1px,horizontal-track.travel)));}
        }
    }
    }
    Rectangle {height:root.expanded?120px:42px;vertical-stretch:0;background:transparent;
        HorizontalBox {padding:0px;spacing:8px;
        command:=CommandEditor {text<=>root.draft;label:root.tr("命令输入",root.english);enabled:root.live&&!root.sending;expanded:root.expanded;
            caret:root.command-caret;revision:root.command-revision;
            edited(value,cursor)=>{root.draft-edited(value,cursor);}
            focused(value)=>{root.editor-focused(value);}
            key(value,ctrl,shift,alt)=>{return root.editor-key(value,ctrl,shift,alt,root.expanded);}
        }
        Rectangle {width:36px;min-height:36px;horizontal-stretch:0;
            expand-button:=DesktopTool {width:parent.width;height:36px;y:(parent.height - self.height)/2;show-text:false;label:root.tr(root.expanded?"收起命令输入框":"展开命令输入框",root.english);icon:root.expanded?@image-url("icons/collapse.svg"):@image-url("icons/expand.svg");enabled:root.enabled;clicked=>{root.expanded=!root.expanded;}}
        }
        Rectangle {width:64px;min-height:36px;horizontal-stretch:0;
            ActionButton {width:parent.width;height:36px;y:(parent.height - self.height)/2;text:root.tr("发送",root.english);primary:true;enabled:root.live&&!root.sending;clicked=>{root.send-command();}}
        }
        }
        if root.completions-visible||root.completion-phase>0:Rectangle {
            x:0px;y:-self.height - 6px;width:command.width;height:completion-content.preferred-height+12px;opacity:root.completion-phase;
            border-radius:13px;border-width:1px;border-color:AppColors.edge;background:AppColors.surface;drop-shadow-offset-y:6px;drop-shadow-blur:24px;drop-shadow-color:#223a661f;
            completion-content:=VerticalBox {padding:6px;spacing:2px;
            if root.completion-loading:Text {text:root.tr("正在补全…",root.english);color:AppColors.ink;vertical-stretch:0;}
            if root.completions.length>0:VerticalBox {padding:0px;spacing:2px;vertical-stretch:0;
        ListView {height:min(4,root.completions.length)*32px;
            property <int> selected:root.completion-index;
            changed selected=>{
                if self.selected*32px+self.viewport-y<0px{self.viewport-y= -self.selected*32px;}
                else if self.selected*32px+self.viewport-y>self.height - 32px{self.viewport-y=self.height - (self.selected+1)*32px;}
            }
            for item[index] in root.completions:Rectangle {
                height:32px;background:index==root.completion-index?AppColors.soft:transparent;
                accessible-role:button;accessible-label:item.label;accessible-action-default=>{root.choose-completion(index);}
                Text {x:8px;width:parent.width - 16px;text:item.label;color:index==root.completion-index?AppColors.accent-ink:AppColors.ink;vertical-alignment:center;overflow:elide;}
                TouchArea {clicked=>{root.choose-completion(index);}}
            }
        }
        if root.completion-truncated:Text {text:root.tr("补全结果较多，请继续输入。",root.english);color:AppColors.ink;}
    }
            }
        }
    }
}
