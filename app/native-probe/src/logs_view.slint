import {CheckBox} from "check_box.slint";
import {VerticalBox,HorizontalBox,ListView,ScrollView} from "std-widgets.slint";
import {SelectBox} from "select_box.slint";
import {ActionButton,ActivityIndicator,AppColors} from "action_button.slint";
export struct LogRow {id:string,command:string,context:string,status:string,tone:int,removable:bool,checked:bool,selected:bool}
export struct LogFact {label:string,value:string}
component LogSelectionBox inherits CheckBox {
    in property <bool> selected;checked:root.selected;
    changed selected=>{root.checked=root.selected;}
}
export component LogsView inherits VerticalBox {
    in property <bool> compact;in property <bool> english;in property <bool> enabled;in property <bool> loading;
    in property <[string]> projects;in property <[string]> days;
    in-out property <int> project-index;in-out property <int> day-index;in-out property <int> status-index;
    in property <[LogRow]> rows;in property <bool> selectable;in-out property <bool> all-checked;in property <int> checked;
    in property <bool> back;in property <bool> next;in property <string> summary;
    in property <string> notice;in property <string> message;in property <string> error;
    in property <bool> selected;in property <bool> reading;in property <string> command;in property <string> output;in property <string> warning;in property <string> file;
    in property <[LogFact]> left-facts;in property <[LogFact]> right-facts;
    pure callback tr(string,bool)->string;
    callback filter(int,int,int);callback refresh();callback select(string);callback toggle(string,bool);callback all(bool);callback page(bool);callback remove();callback open();
    padding:0px;spacing:12px;min-width:0px;
    HorizontalBox {padding:0px;spacing:10px;vertical-stretch:0;
        VerticalBox {padding:0px;spacing:6px;horizontal-stretch:0;preferred-width:root.compact?130px:230px;
            Text {text:root.tr("项目",root.english);font-size:11px;color:AppColors.muted;}
            SelectBox {accessible-label:root.tr("日志项目",root.english);model:root.projects;current-index<=>root.project-index;enabled:root.enabled;selected(i)=>{root.project-index=i;root.filter(i,root.day-index,root.status-index);}}
        }
        VerticalBox {padding:0px;spacing:6px;horizontal-stretch:0;preferred-width:root.compact?130px:230px;
            Text {text:root.tr("日期",root.english);font-size:11px;color:AppColors.muted;}
            SelectBox {accessible-label:root.tr("日志日期",root.english);model:root.days;current-index<=>root.day-index;enabled:root.enabled;selected(i)=>{root.day-index=i;root.filter(root.project-index,i,root.status-index);}}
        }
        VerticalBox {padding:0px;spacing:6px;horizontal-stretch:0;preferred-width:root.compact?130px:230px;
            Text {text:root.tr("状态",root.english);font-size:11px;color:AppColors.muted;}
            SelectBox {accessible-label:root.tr("日志状态",root.english);model:[root.tr("全部状态",root.english),root.tr("记录中",root.english),root.tr("命令成功",root.english),root.tr("命令失败",root.english),root.tr("记录中断",root.english),root.tr("写入失败",root.english),root.tr("会话记录",root.english)];current-index<=>root.status-index;enabled:root.enabled;selected(i)=>{root.status-index=i;root.filter(root.project-index,root.day-index,i);}}
        }
        Rectangle {width:clear-button.preferred-width;horizontal-stretch:0;background:transparent;
            clear-button:=ActionButton {y:parent.height - self.height;text:root.tr("清理所选",root.english);danger:true;icon:@image-url("icons/trash.svg");has-icon:true;enabled:root.enabled&&root.checked>0;clicked=>{root.remove();}}
        }
        Rectangle {background:transparent;horizontal-stretch:1;}
    }
    if root.notice!="":Text {text:root.notice;color:AppColors.muted;wrap:word-wrap;vertical-stretch:0;}
    if root.message!="":Text {text:root.message;color:AppColors.muted;wrap:word-wrap;vertical-stretch:0;}
    if root.error!="":Text {text:root.error;color:AppColors.danger;wrap:word-wrap;vertical-stretch:0;}
    body:=Rectangle {background:transparent;min-height:180px;
        Rectangle {x:0px;y:0px;width:root.compact?parent.width:parent.width*0.44 - 7px;height:root.compact?parent.height*0.45 - 7px:parent.height;background:AppColors.card;border-radius:16px;clip:true;
            VerticalBox {padding:0px;spacing:0px;
                HorizontalBox {padding:12px;height:44px;vertical-stretch:0;
                    CheckBox {width:24px;horizontal-stretch:0;visible:root.rows.length>0;accessible-label:root.tr("选择本页",root.english);checked<=>root.all-checked;indeterminate:root.checked>0&&!root.all-checked;enabled:root.enabled&&root.selectable;toggled=>{root.all(self.checked);}}
                    Text {min-width:0px;preferred-width:0px;horizontal-stretch:1;text:root.summary;color:AppColors.muted;font-size:11px;overflow:elide;vertical-alignment:center;}
                    ActivityIndicator {active:root.loading;}
                }
                if root.rows.length==0:Text {text:root.tr("暂无日志",root.english);color:AppColors.muted;horizontal-alignment:center;}
                ListView {vertical-scrollbar-policy:always-off;horizontal-scrollbar-policy:always-off;
                    for record in root.rows:Rectangle {height:98px;background:record.selected?AppColors.soft:row-touch.has-hover?AppColors.field:transparent;animate background {duration:AppColors.motion?150ms:0ms;}
                        LogSelectionBox {x:12px;y:10px;width:24px;selected:record.checked;enabled:root.enabled&&record.removable;accessible-label:root.tr("选择日志 "+record.command,root.english);toggled=>{root.toggle(record.id,self.checked);}}
                        VerticalBox {x:42px;y:12px;width:parent.width - 58px;height:parent.height - 24px;padding:0px;spacing:6px;
                            Text {text:record.command;color:AppColors.ink;font-size:13px;font-weight:500;overflow:elide;vertical-stretch:0;}
                            Text {text:record.context;color:AppColors.muted;font-size:11px;overflow:elide;vertical-stretch:0;}
                            Rectangle {property <color> tone:record.tone==1?(AppColors.dark?#a9dcc3:#35745b):record.tone==2?AppColors.danger:record.tone==3?(AppColors.dark?#f0d49a:#89651f):AppColors.muted;width:status-label.preferred-width+12px;horizontal-stretch:0;height:20px;vertical-stretch:0;border-radius:5px;background:self.tone.with-alpha(0.08);
                                status-label:=Text {x:6px;width:parent.width - 12px;height:parent.height;text:record.status;font-size:11px;color:parent.tone;vertical-alignment:center;}
                            }
                        }
                        row-keys:=FocusScope {enabled:root.enabled;key-pressed(event)=>{if event.text==Key.Return||event.text==" "{root.select(record.id);return accept;}return reject;}}
                        forward-focus:row-keys;
                        row-touch:=TouchArea {x:38px;width:parent.width - 38px;enabled:root.enabled;clicked=>{row-keys.focus();root.select(record.id);}}
                        accessible-role:list-item;accessible-label:record.command;accessible-action-default=>{root.select(record.id);}
                    }
                }
                if root.back||root.next:HorizontalBox {height:44px;vertical-stretch:0;padding:8px;spacing:8px;
                    ActionButton {text:root.tr("上一页",root.english);enabled:root.enabled&&root.back;clicked=>{root.page(false);}}
                    Rectangle {background:transparent;horizontal-stretch:1;}
                    ActionButton {text:root.tr("下一页",root.english);enabled:root.enabled&&root.next;clicked=>{root.page(true);}}
                }
            }
        }
        details-panel:=Rectangle {x:root.compact?0px:parent.width*0.44+7px;y:root.compact?parent.height*0.45+7px:0px;width:root.compact?parent.width:parent.width*0.56 - 7px;height:root.compact?parent.height*0.55 - 7px:parent.height;background:AppColors.card;border-radius:16px;
            VerticalBox {padding:18px;spacing:12px;
                HorizontalBox {padding:0px;spacing:8px;vertical-stretch:0;
                    Text {text:root.tr("运行详情",root.english);font-size:16px;font-weight:600;color:AppColors.ink;}
                    Rectangle {background:transparent;horizontal-stretch:1;}
                    ActionButton {visible:root.selected;text:root.tr("打开所在目录",root.english);enabled:root.enabled&&root.selected;clicked=>{root.open();}}
                    ActivityIndicator {active:root.reading&&root.output=="";}
                }
                if !root.selected:Text {text:root.tr("选择一份日志查看详情",root.english);color:AppColors.muted;vertical-stretch:0;}
                if root.selected:ScrollView {viewport-width:self.visible-width;viewport-height:max(self.visible-height,detail-content.preferred-height);vertical-scrollbar-policy:always-off;horizontal-scrollbar-policy:always-off;min-height:0px;
                detail-content:=VerticalBox {x:0px;y:0px;width:parent.width;height:max(parent.height,self.preferred-height);padding:0px;spacing:12px;
                    Rectangle {height:42px;vertical-stretch:0;border-radius:10px;background:AppColors.inset;
                        Text {x:12px;width:parent.width - 24px;height:parent.height;text:root.command;color:AppColors.ink;overflow:elide;vertical-alignment:center;}
                    }
                    HorizontalBox {padding:0px;spacing:14px;vertical-stretch:0;
                        VerticalBox {padding:0px;spacing:10px;preferred-width:0px;horizontal-stretch:1;
                            for fact in root.left-facts:VerticalBox {padding:0px;spacing:3px;vertical-stretch:0;Text {text:fact.label;color:AppColors.muted;font-size:11px;}Text {text:fact.value;color:AppColors.ink;font-size:12px;overflow:elide;}}
                        }
                        VerticalBox {padding:0px;spacing:10px;preferred-width:0px;horizontal-stretch:1;
                            for fact in root.right-facts:VerticalBox {padding:0px;spacing:3px;vertical-stretch:0;Text {text:fact.label;color:AppColors.muted;font-size:11px;}Text {text:fact.value;color:AppColors.ink;font-size:12px;overflow:elide;}}
                        }
                    }
                    if root.warning!="":Text {text:root.warning;color:AppColors.danger;font-size:11px;wrap:word-wrap;vertical-stretch:0;}
                    Rectangle {background:AppColors.terminal;border-radius:10px;clip:true;height:max(160px,details-panel.height - 300px);vertical-stretch:0;
                        output-scroll:=ScrollView {x:12px;y:12px;width:parent.width - 24px;height:parent.height - 24px;viewport-width:max(self.visible-width,raw.preferred-width);viewport-height:max(self.visible-height,raw.preferred-height);
                            raw:=TextInput {width:output-scroll.viewport-width;height:output-scroll.viewport-height;text:root.output;read-only:true;single-line:false;wrap:no-wrap;color:#e0e7f3;font-family:"Consolas";font-size:12px;accessible-label:root.tr("日志原文",root.english);}
                        }
                    }
                    Text {text:root.file;color:AppColors.muted;font-size:10px;overflow:elide;vertical-stretch:0;}
                }
                }
            }
        }
    }
}
