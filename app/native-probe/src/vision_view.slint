import {ScrollView,VerticalBox,HorizontalBox} from "std-widgets.slint";
import {ActionButton,ActivityIndicator,AppColors} from "action_button.slint";
import {SelectBox} from "select_box.slint";
import {CheckBox} from "check_box.slint";
import {LiquidSlider} from "liquid_slider.slint";
import {SegmentedChoice} from "settings_controls.slint";

export struct VisionFact {
    label: string,
    value: string,
}

export struct VisionHolder {
    pid: string,
    name: string,
    device: string,
    command: string,
    stats: string,
}

component SliderRow inherits VerticalBox {
    in property <string> label;
    in property <string> value-text;
    in-out property <float> value;
    in property <float> minimum: 0;
    in property <float> maximum: 255;
    in property <float> step: 1;
    in property <bool> enabled: true;
    callback edited(float);
    padding: 0px;
    spacing: 2px;
    vertical-stretch: 0;
    HorizontalBox {
        padding: 0px;
        spacing: 6px;
        vertical-stretch: 0;
        Text {
            text: root.label;
            font-size: 11px;
            color: AppColors.muted;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Text {
            text: root.value-text;
            font-size: 11px;
            font-weight: 600;
            color: AppColors.ink;
            vertical-alignment: center;
            horizontal-stretch: 0;
        }
    }
    LiquidSlider {
        height: 28px;
        value <=> root.value;
        minimum: root.minimum;
        maximum: root.maximum;
        step: root.step;
        enabled: root.enabled;
        changed(v) => { root.edited(v); }
        released(v) => { root.edited(v); }
    }
}

component TelemetryCard inherits Rectangle {
    in property <bool> english;
    in property <int> columns: 3;
    in property <string> telemetry-summary;
    in property <[VisionFact]> facts;
    pure callback tr(string, bool) -> string;
    property <color> hairline: AppColors.dark ? #ffffff14 : #536d8b18;
    background: AppColors.card;
    border-radius: 16px;
    border-width: 1px;
    border-color: AppColors.edge;
    vertical-stretch: 0;
    VerticalBox {
        padding: 14px;
        spacing: 8px;
        HorizontalBox {
            padding: 0px;
            spacing: 10px;
            vertical-stretch: 0;
            Text {
                text: root.tr("实时识别遥测", root.english);
                font-size: 13px;
                font-weight: 600;
                color: AppColors.ink;
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            if root.telemetry-summary != "": Text {
                text: root.telemetry-summary;
                font-size: 12px;
                color: AppColors.accent-ink;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }
        if root.facts.length > 0: GridLayout {
            padding: 0px;
            spacing: 8px;
            vertical-stretch: 0;
            for fact[index] in root.facts: Rectangle {
                col: mod(index, max(1, root.columns));
                row: floor(index / max(1, root.columns));
                preferred-width: 0px;
                horizontal-stretch: 1;
                border-radius: 10px;
                background: AppColors.inset;
                border-width: 1px;
                border-color: root.hairline;
                VerticalBox {
                    padding: 8px;
                    spacing: 2px;
                    Text {
                        text: fact.label;
                        font-size: 10px;
                        color: AppColors.muted;
                        overflow: elide;
                    }
                    Text {
                        text: fact.value;
                        font-size: 12px;
                        font-weight: 600;
                        color: AppColors.ink;
                        overflow: elide;
                    }
                }
            }
        }
        if root.facts.length == 0 && root.telemetry-summary == "": Text {
            text: root.tr("开启画面后显示实时处理耗时与检测结果", root.english);
            font-size: 12px;
            color: AppColors.muted;
            wrap: word-wrap;
        }
    }
}

component CompanionCard inherits Rectangle {
    in property <bool> english;
    in property <bool> enabled;
    in property <bool> board-busy;
    in property <string> board-summary;
    in property <[VisionHolder]> holders;
    in property <bool> shared-available;
    pure callback tr(string, bool) -> string;
    callback copy-snippet();

    property <color> hairline: AppColors.dark ? #ffffff14 : #536d8b18;
    property <color> busy-tone: AppColors.dark ? #f0c97d : #b87a14;
    property <color> ok-tone: AppColors.dark ? #8fd6b4 : #235d42;
    background: AppColors.card;
    border-radius: 16px;
    border-width: 1px;
    border-color: root.board-busy ? root.busy-tone.with-alpha(0.35) : AppColors.edge;
    vertical-stretch: 0;
    VerticalBox {
        padding: 14px;
        spacing: 8px;
        HorizontalBox {
            padding: 0px;
            spacing: 8px;
            vertical-stretch: 0;
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.board-busy ? root.busy-tone : root.ok-tone;
                }
            }
            Text {
                text: root.tr(root.board-busy ? "板端摄像头代码运行中" : "板端摄像头空闲", root.english);
                font-size: 13px;
                font-weight: 600;
                color: AppColors.ink;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if root.shared-available: VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                Rectangle {
                    width: shm-lbl.preferred-width + 14px;
                    height: 22px;
                    border-radius: 7px;
                    background: root.ok-tone.with-alpha(0.14);
                    shm-lbl:= Text {
                        x: 7px;
                        width: parent.width - 14px;
                        height: parent.height;
                        text: root.tr("共享帧在线", root.english);
                        font-size: 11px;
                        font-weight: 500;
                        color: root.ok-tone;
                        vertical-alignment: center;
                    }
                }
            }
            VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                ActionButton {
                    text: root.tr("复制无头接入片段", root.english);
                    enabled: root.enabled;
                    clicked => { root.copy-snippet(); }
                }
            }
        }
        if root.board-summary != "": Text {
            text: root.board-summary;
            font-size: 12px;
            color: AppColors.muted;
            wrap: word-wrap;
            vertical-stretch: 0;
        }
        for holder in root.holders: Rectangle {
            border-radius: 10px;
            background: AppColors.inset;
            border-width: 1px;
            border-color: root.hairline;
            vertical-stretch: 0;
            VerticalBox {
                padding: 10px;
                spacing: 4px;
                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    vertical-stretch: 0;
                    Text {
                        text: holder.name + " · PID " + holder.pid + " · " + holder.device;
                        font-size: 12px;
                        font-weight: 600;
                        color: AppColors.ink;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    Text {
                        text: holder.stats;
                        font-size: 11px;
                        color: AppColors.muted;
                        horizontal-stretch: 0;
                    }
                }
                Text {
                    text: holder.command;
                    font-size: 11px;
                    color: AppColors.muted;
                    overflow: elide;
                }
            }
        }
    }
}

component InspectorCard inherits Rectangle {
    in property <bool> english;
    in property <bool> enabled;
    in property <bool> watch-mode;
    in-out property <int> algo;
    in-out property <bool> apply-on-watch;
    in-out property <bool> flip-h;
    in-out property <bool> flip-v;
    in-out property <bool> crosshair;
    in-out property <int> binary-mode;
    in-out property <int> thresh;
    in-out property <int> blur;
    in-out property <int> feature-mode;
    in-out property <int> canny-low;
    in-out property <int> canny-high;
    in-out property <int> hsv-preset;
    in-out property <int> hsv-view;
    in-out property <int> h-low;
    in-out property <int> h-high;
    in-out property <int> s-low;
    in-out property <int> s-high;
    in-out property <int> v-low;
    in-out property <int> v-high;
    in-out property <bool> morph;
    in-out property <bool> line-roi;
    in-out property <int> hough-param2;
    in-out property <int> min-radius;
    in-out property <bool> draw-contours;
    in-out property <int> tag-family;
    in-out property <bool> tag-guide;
    in-out property <int> face-neighbors;
    in-out property <int> face-min-size;
    in property <string> telemetry-summary;
    in property <[VisionFact]> facts;
    pure callback tr(string, bool) -> string;
    callback config-changed();
    callback preset-changed(int);

    property <color> hairline: AppColors.dark ? #ffffff14 : #536d8b18;
    background: transparent;
    vertical-stretch: 0;
    VerticalBox {
        padding: 0px;
        spacing: 12px;

        Rectangle {
            background: AppColors.card;
            border-radius: 16px;
            border-width: 1px;
            border-color: AppColors.edge;
            vertical-stretch: 0;
            VerticalBox {
                padding: 16px;
                spacing: 12px;

                HorizontalBox {
                    padding: 0px;
                    spacing: 8px;
                    vertical-stretch: 0;
                    Text {
                        text: root.tr("OpenCV 算法实验", root.english);
                        font-size: 13px;
                        font-weight: 600;
                        color: AppColors.ink;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.watch-mode: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        CheckBox {
                            text: root.tr("叠加到伴随画面", root.english);
                            checked <=> root.apply-on-watch;
                            enabled: root.enabled;
                            toggled => { root.config-changed(); }
                        }
                    }
                }

                SelectBox {
                    height: 36px;
                    enabled: root.enabled;
                    model: [
                        root.tr("原图预览", root.english),
                        root.tr("灰度与二值化", root.english),
                        root.tr("边缘与角点", root.english),
                        root.tr("HSV 颜色与巡线", root.english),
                        root.tr("霍夫圆与形状", root.english),
                        root.tr("AprilTag 定位", root.english),
                        root.tr("Haar 人脸检测", root.english)
                    ];
                    current-index <=> root.algo;
                    selected(i) => { root.algo = i; root.config-changed(); }
                }

                Rectangle { height: 1px; vertical-stretch: 0; background: root.hairline; }

                if root.algo == 0: VerticalBox {
                    padding: 0px;
                    spacing: 10px;
                    vertical-stretch: 0;
                    CheckBox {
                        text: root.tr("水平镜像翻转", root.english);
                        checked <=> root.flip-h;
                        enabled: root.enabled;
                        toggled => { root.config-changed(); }
                    }
                    CheckBox {
                        text: root.tr("垂直翻转", root.english);
                        checked <=> root.flip-v;
                        enabled: root.enabled;
                        toggled => { root.config-changed(); }
                    }
                    CheckBox {
                        text: root.tr("中心十字准星", root.english);
                        checked <=> root.crosshair;
                        enabled: root.enabled;
                        toggled => { root.config-changed(); }
                    }
                }

                if root.algo == 1: VerticalBox {
                    padding: 0px;
                    spacing: 10px;
                    vertical-stretch: 0;
                    SegmentedChoice {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        model: [
                            root.tr("灰度", root.english),
                            root.tr("固定阈值", root.english),
                            root.tr("Otsu 自动", root.english)
                        ];
                        current-index: root.binary-mode;
                        enabled: root.enabled;
                        selected(i) => { root.binary-mode = i; root.config-changed(); }
                    }
                    if root.binary-mode == 1: SliderRow {
                        label: root.tr("二值化阈值", root.english);
                        value-text: "" + root.thresh;
                        value: root.thresh;
                        minimum: 0;
                        maximum: 255;
                        step: 1;
                        enabled: root.enabled;
                        edited(v) => { root.thresh = round(v); root.config-changed(); }
                    }
                    SliderRow {
                        label: root.tr("高斯模糊核", root.english);
                        value-text: root.blur <= 1 ? root.tr("关闭", root.english) : "" + root.blur + "×" + root.blur;
                        value: root.blur;
                        minimum: 1;
                        maximum: 11;
                        step: 2;
                        enabled: root.enabled;
                        edited(v) => { root.blur = round(v); root.config-changed(); }
                    }
                }

                if root.algo == 2: VerticalBox {
                    padding: 0px;
                    spacing: 10px;
                    vertical-stretch: 0;
                    SegmentedChoice {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        model: [
                            root.tr("Canny 边缘", root.english),
                            root.tr("Sobel 梯度", root.english),
                            root.tr("Shi-Tomasi 角点", root.english)
                        ];
                        current-index: root.feature-mode;
                        enabled: root.enabled;
                        selected(i) => { root.feature-mode = i; root.config-changed(); }
                    }
                    if root.feature-mode == 0: VerticalBox {
                        padding: 0px;
                        spacing: 6px;
                        vertical-stretch: 0;
                        SliderRow {
                            label: root.tr("Canny 低阈值", root.english);
                            value-text: "" + root.canny-low;
                            value: root.canny-low;
                            minimum: 5;
                            maximum: 200;
                            step: 5;
                            enabled: root.enabled;
                            edited(v) => { root.canny-low = round(v); root.config-changed(); }
                        }
                        SliderRow {
                            label: root.tr("Canny 高阈值", root.english);
                            value-text: "" + root.canny-high;
                            value: root.canny-high;
                            minimum: 20;
                            maximum: 300;
                            step: 5;
                            enabled: root.enabled;
                            edited(v) => { root.canny-high = round(v); root.config-changed(); }
                        }
                    }
                }

                if root.algo == 3: VerticalBox {
                    padding: 0px;
                    spacing: 8px;
                    vertical-stretch: 0;
                    SelectBox {
                        height: 36px;
                        enabled: root.enabled;
                        model: [
                            root.tr("预设：红色（双区间）", root.english),
                            root.tr("预设：蓝色", root.english),
                            root.tr("预设：绿色", root.english),
                            root.tr("预设：黄色", root.english),
                            root.tr("自定义 HSV 范围", root.english)
                        ];
                        current-index <=> root.hsv-preset;
                        selected(i) => { root.hsv-preset = i; root.preset-changed(i); }
                    }
                    SegmentedChoice {
                        horizontal-stretch: 1;
                        preferred-width: 0px;
                        model: [
                            root.tr("叠加标注", root.english),
                            root.tr("黑白掩码", root.english),
                            root.tr("颜色提取", root.english)
                        ];
                        current-index: root.hsv-view;
                        enabled: root.enabled;
                        selected(i) => { root.hsv-view = i; root.config-changed(); }
                    }
                    SliderRow {
                        label: "H " + root.tr("下限", root.english);
                        value-text: "" + root.h-low;
                        value: root.h-low;
                        minimum: 0;
                        maximum: 180;
                        step: 1;
                        enabled: root.enabled;
                        edited(v) => { root.h-low = round(v); root.hsv-preset = 4; root.config-changed(); }
                    }
                    SliderRow {
                        label: "H " + root.tr("上限", root.english);
                        value-text: "" + root.h-high;
                        value: root.h-high;
                        minimum: 0;
                        maximum: 180;
                        step: 1;
                        enabled: root.enabled;
                        edited(v) => { root.h-high = round(v); root.hsv-preset = 4; root.config-changed(); }
                    }
                    SliderRow {
                        label: "S " + root.tr("下限", root.english);
                        value-text: root.s-low + " – " + root.s-high;
                        value: root.s-low;
                        minimum: 0;
                        maximum: 255;
                        step: 5;
                        enabled: root.enabled;
                        edited(v) => { root.s-low = round(v); root.hsv-preset = 4; root.config-changed(); }
                    }
                    SliderRow {
                        label: "V " + root.tr("下限", root.english);
                        value-text: root.v-low + " – " + root.v-high;
                        value: root.v-low;
                        minimum: 0;
                        maximum: 255;
                        step: 5;
                        enabled: root.enabled;
                        edited(v) => { root.v-low = round(v); root.hsv-preset = 4; root.config-changed(); }
                    }
                    HorizontalBox {
                        padding: 0px;
                        spacing: 14px;
                        vertical-stretch: 0;
                        CheckBox {
                            text: root.tr("形态学去噪", root.english);
                            checked <=> root.morph;
                            enabled: root.enabled;
                            toggled => { root.config-changed(); }
                        }
                        CheckBox {
                            text: root.tr("底部巡线 ROI", root.english);
                            checked <=> root.line-roi;
                            enabled: root.enabled;
                            toggled => { root.config-changed(); }
                        }
                    }
                }

                if root.algo == 4: VerticalBox {
                    padding: 0px;
                    spacing: 8px;
                    vertical-stretch: 0;
                    SliderRow {
                        label: root.tr("霍夫圆灵敏度 (param2)", root.english);
                        value-text: "" + root.hough-param2;
                        value: root.hough-param2;
                        minimum: 15;
                        maximum: 80;
                        step: 1;
                        enabled: root.enabled;
                        edited(v) => { root.hough-param2 = round(v); root.config-changed(); }
                    }
                    SliderRow {
                        label: root.tr("最小圆半径 (px)", root.english);
                        value-text: root.min-radius + " px";
                        value: root.min-radius;
                        minimum: 5;
                        maximum: 80;
                        step: 1;
                        enabled: root.enabled;
                        edited(v) => { root.min-radius = round(v); root.config-changed(); }
                    }
                    CheckBox {
                        text: root.tr("标注轮廓与多边形", root.english);
                        checked <=> root.draw-contours;
                        enabled: root.enabled;
                        toggled => { root.config-changed(); }
                    }
                }

                if root.algo == 5: VerticalBox {
                    padding: 0px;
                    spacing: 10px;
                    vertical-stretch: 0;
                    SelectBox {
                        enabled: root.enabled;
                        model: ["tag36h11", "tag25h9", "tag36h11 + tag25h9"];
                        current-index <=> root.tag-family;
                        selected(i) => { root.tag-family = i; root.config-changed(); }
                    }
                    CheckBox {
                        text: root.tr("显示 ±40px 居中引导线", root.english);
                        checked <=> root.tag-guide;
                        enabled: root.enabled;
                        toggled => { root.config-changed(); }
                    }
                }

                if root.algo == 6: VerticalBox {
                    padding: 0px;
                    spacing: 8px;
                    vertical-stretch: 0;
                    SliderRow {
                        label: root.tr("检测置信邻居数", root.english);
                        value-text: "" + root.face-neighbors;
                        value: root.face-neighbors;
                        minimum: 2;
                        maximum: 8;
                        step: 1;
                        enabled: root.enabled;
                        edited(v) => { root.face-neighbors = round(v); root.config-changed(); }
                    }
                    SliderRow {
                        label: root.tr("最小人脸尺寸 (px)", root.english);
                        value-text: root.face-min-size + " px";
                        value: root.face-min-size;
                        minimum: 24;
                        maximum: 120;
                        step: 4;
                        enabled: root.enabled;
                        edited(v) => { root.face-min-size = round(v); root.config-changed(); }
                    }
                }
            }
        }
    }
}

export component VisionView inherits Rectangle {
    in property <bool> english;
    in property <bool> compact;
    in property <bool> enabled;
    in property <bool> connected;
    in property <[string]> cameras;
    in-out property <int> camera-index: 0;
    in property <[string]> windows;
    in-out property <int> window-index: 0;
    in-out property <int> source-mode: 0;
    in-out property <int> rate: 1;
    in property <bool> active;
    in property <bool> loading;
    in property <image> frame;
    in property <bool> has-frame;
    in property <string> status;
    in property <string> source-badge;
    in property <int> status-phase;
    in property <string> error;
    in property <bool> board-busy;
    in property <string> board-summary;
    in property <[VisionHolder]> holders;
    in property <bool> shared-available;
    in property <string> capabilities;
    in-out property <int> algo: 0;
    in-out property <bool> apply-on-watch: false;
    in-out property <bool> flip-h: false;
    in-out property <bool> flip-v: false;
    in-out property <bool> crosshair: true;
    in-out property <int> binary-mode: 2;
    in-out property <int> thresh: 127;
    in-out property <int> blur: 5;
    in-out property <int> feature-mode: 0;
    in-out property <int> canny-low: 30;
    in-out property <int> canny-high: 100;
    in-out property <int> hsv-preset: 0;
    in-out property <int> hsv-view: 0;
    in-out property <int> h-low: 0;
    in-out property <int> h-high: 10;
    in-out property <int> s-low: 50;
    in-out property <int> s-high: 255;
    in-out property <int> v-low: 50;
    in-out property <int> v-high: 255;
    in-out property <bool> morph: true;
    in-out property <bool> line-roi: false;
    in-out property <int> hough-param2: 35;
    in-out property <int> min-radius: 12;
    in-out property <bool> draw-contours: true;
    in-out property <int> tag-family: 0;
    in-out property <bool> tag-guide: true;
    in-out property <int> face-neighbors: 4;
    in-out property <int> face-min-size: 36;
    in property <string> telemetry-summary;
    in property <[VisionFact]> facts;

    pure callback tr(string, bool) -> string;
    callback toggle-stream();
    callback refresh-board();
    callback config-changed();
    callback preset-changed(int);
    callback copy-snippet();
    callback snapshot();
    callback connect-device();

    property <bool> stacked: root.compact || root.width < 940px;
    property <color> hairline: AppColors.dark ? #ffffff14 : #536d8b18;
    property <color> busy-tone: AppColors.dark ? #f0c97d : #b87a14;
    property <color> ok-tone: AppColors.dark ? #8fd6b4 : #235d42;
    background: transparent;

    if !root.connected: Rectangle {
        width: parent.width;
        height: parent.height;
        background: AppColors.card;
        border-radius: 18px;
        border-width: 1px;
        border-color: AppColors.edge;
        VerticalBox {
            alignment: center;
            spacing: 14px;
            padding: 36px;
            HorizontalBox {
                padding: 0px;
                Rectangle { background: transparent; horizontal-stretch: 1; }
                Rectangle {
                    width: 52px;
                    height: 52px;
                    horizontal-stretch: 0;
                    border-radius: 16px;
                    background: AppColors.soft;
                    Image {
                        x: 14px;
                        y: 14px;
                        width: 24px;
                        height: 24px;
                        source: @image-url("icons/vision.svg");
                        colorize: AppColors.accent;
                    }
                }
                Rectangle { background: transparent; horizontal-stretch: 1; }
            }
            Text {
                text: root.tr("连接设备后使用视觉实验台", root.english);
                font-size: 16px;
                font-weight: 600;
                color: AppColors.ink;
                horizontal-alignment: center;
            }
            HorizontalBox {
                padding: 0px;
                Rectangle { background: transparent; horizontal-stretch: 1; }
                ActionButton {
                    text: root.tr("前往连接设备", root.english);
                    primary: true;
                    enabled: root.enabled;
                    clicked => { root.connect-device(); }
                }
                Rectangle { background: transparent; horizontal-stretch: 1; }
            }
        }
    }

    if root.connected: ScrollView {
        width: parent.width;
        height: parent.height;
        viewport-width: self.visible-width;
        viewport-height: max(self.visible-height, body.preferred-height + 8px);
        vertical-scrollbar-policy: always-off;
        horizontal-scrollbar-policy: always-off;

        body:= VerticalBox {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: self.preferred-height;
            padding: 0px;
            spacing: 12px;

            if root.error != "": Rectangle {
                vertical-stretch: 0;
                border-radius: 12px;
                background: AppColors.danger.with-alpha(0.08);
                border-width: 1px;
                border-color: AppColors.danger.with-alpha(0.22);
                HorizontalBox {
                    padding: 12px;
                    Text {
                        text: root.error;
                        font-size: 12px;
                        color: AppColors.danger;
                        wrap: word-wrap;
                    }
                }
            }

            Rectangle {
                background: AppColors.card;
                border-radius: 16px;
                border-width: 1px;
                border-color: AppColors.edge;
                vertical-stretch: 0;
                HorizontalBox {
                    padding: 12px;
                    spacing: 10px;
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        SegmentedChoice {
                            width: 210px;
                            model: [
                                root.tr("自动", root.english),
                                root.tr("直采", root.english),
                                root.tr("伴随监视", root.english)
                            ];
                            current-index: root.source-mode;
                            enabled: root.enabled && !root.loading;
                            selected(i) => { root.source-mode = i; root.config-changed(); }
                        }
                    }
                    if root.source-mode != 2: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        SelectBox {
                            enabled: root.enabled && !root.active && !root.loading && root.cameras.length > 0;
                            model: root.cameras.length > 0 ? root.cameras : [root.tr("未检测到摄像头", root.english)];
                            current-index <=> root.camera-index;
                        }
                    }
                    if root.source-mode == 2: VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 1;
                        SelectBox {
                            enabled: root.enabled && !root.loading && root.windows.length > 0;
                            model: root.windows.length > 0 ? root.windows : [root.tr("自动探测板端画面", root.english)];
                            current-index <=> root.window-index;
                            selected(i) => { root.window-index = i; root.config-changed(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        SelectBox {
                            width: 88px;
                            enabled: root.enabled && !root.loading;
                            model: ["8 FPS", "15 FPS", "20 FPS", "30 FPS"];
                            current-index <=> root.rate;
                            selected(i) => { root.rate = i; root.config-changed(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        ActionButton {
                            text: root.tr("刷新", root.english);
                            icon: @image-url("icons/restart.svg");
                            has-icon: true;
                            enabled: root.enabled && !root.loading;
                            clicked => { root.refresh-board(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        ActionButton {
                            text: root.tr(root.active ? "停止画面" : "开启画面", root.english);
                            icon: @image-url("icons/connect.svg");
                            has-icon: true;
                            primary: !root.active;
                            danger: root.active;
                            busy: root.loading;
                            enabled: root.enabled && !root.loading;
                            clicked => { root.toggle-stream(); }
                        }
                    }
                }
            }

            if !root.stacked: HorizontalBox {
                padding: 0px;
                spacing: 14px;
                vertical-stretch: 0;

                VerticalBox {
                    padding: 0px;
                    spacing: 12px;
                    preferred-width: 0px;
                    horizontal-stretch: 64;

                    Rectangle {
                        background: AppColors.card;
                        border-radius: 16px;
                        border-width: 1px;
                        border-color: AppColors.edge;
                        vertical-stretch: 0;
                        VerticalBox {
                            padding: 12px;
                            spacing: 10px;
                            Rectangle {
                                height: clamp(self.width * 0.5625, 270px, 390px);
                                vertical-stretch: 0;
                                border-radius: 12px;
                                background: #111a28;
                                clip: true;
                                if root.has-frame: Image {
                                    width: parent.width;
                                    height: parent.height;
                                    source: root.frame;
                                    image-fit: contain;
                                }
                                if !root.has-frame: VerticalBox {
                                    alignment: center;
                                    spacing: 10px;
                                    HorizontalBox {
                                        padding: 0px;
                                        Rectangle { background: transparent; horizontal-stretch: 1; }
                                        ActivityIndicator { active: root.loading; ink: #ffffff; }
                                        Rectangle { background: transparent; horizontal-stretch: 1; }
                                    }
                                    Text {
                                        text: root.tr(root.status != "" ? root.status : "点击「开启画面」开始 OpenCV 实验或伴随监视", root.english);
                                        font-size: 13px;
                                        color: #a9b6ca;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                                if root.source-badge != "": Rectangle {
                                    x: 10px;
                                    y: 10px;
                                    width: min(parent.width - 20px, hud-lbl.preferred-width + 18px);
                                    height: 26px;
                                    border-radius: 13px;
                                    background: #111a28cc;
                                    border-width: 1px;
                                    border-color: #ffffff26;
                                    hud-lbl:= Text {
                                        x: 9px;
                                        width: parent.width - 18px;
                                        height: parent.height;
                                        text: root.source-badge;
                                        font-size: 11px;
                                        font-weight: 500;
                                        color: #f4f7fb;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                            HorizontalBox {
                                padding: 0px;
                                spacing: 8px;
                                vertical-stretch: 0;
                                Text {
                                    text: root.capabilities != "" ? root.capabilities : root.tr("OpenCV 实时管线就绪", root.english);
                                    font-size: 11px;
                                    color: AppColors.muted;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                if root.has-frame: VerticalLayout {
                                    alignment: center;
                                    horizontal-stretch: 0;
                                    ActionButton {
                                        text: root.tr("保存快照", root.english);
                                        icon: @image-url("icons/download.svg");
                                        has-icon: true;
                                        enabled: root.enabled;
                                        clicked => { root.snapshot(); }
                                    }
                                }
                            }
                        }
                    }

                    TelemetryCard {
                        english: root.english;
                        columns: 3;
                        telemetry-summary: root.telemetry-summary;
                        facts: root.facts;
                        tr(s, e) => { return root.tr(s, e); }
                    }

                    Rectangle { background: transparent; vertical-stretch: 1; }
                }

                VerticalBox {
                    padding: 0px;
                    spacing: 12px;
                    preferred-width: 0px;
                    horizontal-stretch: 36;

                    InspectorCard {
                        english: root.english;
                        enabled: root.enabled;
                        watch-mode: root.source-mode == 2 || root.board-busy;
                        algo <=> root.algo;
                        apply-on-watch <=> root.apply-on-watch;
                        flip-h <=> root.flip-h;
                        flip-v <=> root.flip-v;
                        crosshair <=> root.crosshair;
                        binary-mode <=> root.binary-mode;
                        thresh <=> root.thresh;
                        blur <=> root.blur;
                        feature-mode <=> root.feature-mode;
                        canny-low <=> root.canny-low;
                        canny-high <=> root.canny-high;
                        hsv-preset <=> root.hsv-preset;
                        hsv-view <=> root.hsv-view;
                        h-low <=> root.h-low;
                        h-high <=> root.h-high;
                        s-low <=> root.s-low;
                        s-high <=> root.s-high;
                        v-low <=> root.v-low;
                        v-high <=> root.v-high;
                        morph <=> root.morph;
                        line-roi <=> root.line-roi;
                        hough-param2 <=> root.hough-param2;
                        min-radius <=> root.min-radius;
                        draw-contours <=> root.draw-contours;
                        tag-family <=> root.tag-family;
                        tag-guide <=> root.tag-guide;
                        face-neighbors <=> root.face-neighbors;
                        face-min-size <=> root.face-min-size;
                        telemetry-summary: root.telemetry-summary;
                        facts: root.facts;
                        tr(s, e) => { return root.tr(s, e); }
                        config-changed => { root.config-changed(); }
                        preset-changed(i) => { root.preset-changed(i); }
                    }

                    CompanionCard {
                        english: root.english;
                        enabled: root.enabled;
                        board-busy: root.board-busy;
                        board-summary: root.board-summary;
                        holders: root.holders;
                        shared-available: root.shared-available;
                        tr(s, e) => { return root.tr(s, e); }
                        copy-snippet => { root.copy-snippet(); }
                    }

                    Rectangle { background: transparent; vertical-stretch: 1; }
                }
            }

            if root.stacked: VerticalBox {
                padding: 0px;
                spacing: 12px;
                vertical-stretch: 0;

                Rectangle {
                    background: AppColors.card;
                    border-radius: 16px;
                    border-width: 1px;
                    border-color: AppColors.edge;
                    vertical-stretch: 0;
                    VerticalBox {
                        padding: 12px;
                        spacing: 10px;
                        Rectangle {
                            height: clamp(self.width * 0.62, 240px, 380px);
                            border-radius: 12px;
                            background: #111a28;
                            clip: true;
                            if root.has-frame: Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.frame;
                                image-fit: contain;
                            }
                            if !root.has-frame: VerticalBox {
                                alignment: center;
                                spacing: 8px;
                                HorizontalBox {
                                    padding: 0px;
                                    Rectangle { background: transparent; horizontal-stretch: 1; }
                                    ActivityIndicator { active: root.loading; ink: #ffffff; }
                                    Rectangle { background: transparent; horizontal-stretch: 1; }
                                }
                                Text {
                                    text: root.tr(root.status != "" ? root.status : "点击「开启画面」开始 OpenCV 实验或伴随监视", root.english);
                                    font-size: 12px;
                                    color: #a9b6ca;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                            if root.source-badge != "": Rectangle {
                                x: 10px;
                                y: 10px;
                                width: min(parent.width - 20px, hud-lbl-s.preferred-width + 18px);
                                height: 26px;
                                border-radius: 13px;
                                background: #111a28cc;
                                border-width: 1px;
                                border-color: #ffffff26;
                                hud-lbl-s:= Text {
                                    x: 9px;
                                    width: parent.width - 18px;
                                    height: parent.height;
                                    text: root.source-badge;
                                    font-size: 11px;
                                    font-weight: 500;
                                    color: #f4f7fb;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                TelemetryCard {
                    english: root.english;
                    columns: 2;
                    telemetry-summary: root.telemetry-summary;
                    facts: root.facts;
                    tr(s, e) => { return root.tr(s, e); }
                }

                InspectorCard {
                    english: root.english;
                    enabled: root.enabled;
                    watch-mode: root.source-mode == 2 || root.board-busy;
                    algo <=> root.algo;
                    apply-on-watch <=> root.apply-on-watch;
                    flip-h <=> root.flip-h;
                    flip-v <=> root.flip-v;
                    crosshair <=> root.crosshair;
                    binary-mode <=> root.binary-mode;
                    thresh <=> root.thresh;
                    blur <=> root.blur;
                    feature-mode <=> root.feature-mode;
                    canny-low <=> root.canny-low;
                    canny-high <=> root.canny-high;
                    hsv-preset <=> root.hsv-preset;
                    hsv-view <=> root.hsv-view;
                    h-low <=> root.h-low;
                    h-high <=> root.h-high;
                    s-low <=> root.s-low;
                    s-high <=> root.s-high;
                    v-low <=> root.v-low;
                    v-high <=> root.v-high;
                    morph <=> root.morph;
                    line-roi <=> root.line-roi;
                    hough-param2 <=> root.hough-param2;
                    min-radius <=> root.min-radius;
                    draw-contours <=> root.draw-contours;
                    tag-family <=> root.tag-family;
                    tag-guide <=> root.tag-guide;
                    face-neighbors <=> root.face-neighbors;
                    face-min-size <=> root.face-min-size;
                    telemetry-summary: root.telemetry-summary;
                    facts: root.facts;
                    tr(s, e) => { return root.tr(s, e); }
                    config-changed => { root.config-changed(); }
                    preset-changed(i) => { root.preset-changed(i); }
                }

                CompanionCard {
                    english: root.english;
                    enabled: root.enabled;
                    board-busy: root.board-busy;
                    board-summary: root.board-summary;
                    holders: root.holders;
                    shared-available: root.shared-available;
                    tr(s, e) => { return root.tr(s, e); }
                    copy-snippet => { root.copy-snippet(); }
                }
            }
        }
    }
}
