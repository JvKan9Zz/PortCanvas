import {AppColors} from "action_button.slint";
export component CheckBox inherits Rectangle {
    in-out property <bool> checked:false;in property <bool> indeterminate:false;
    in property <string> text;in property <bool> enabled:true;callback toggled();
    height:24px;vertical-stretch:0;preferred-width:root.text==""?16px:caption.preferred-width+24px;
    background:transparent;opacity:root.enabled?1:0.45;forward-focus:keys;
    accessible-role:checkbox;accessible-label:root.text;accessible-enabled:root.enabled;accessible-checkable:true;accessible-checked:root.checked;accessible-action-default=>{root.toggle();}
    function toggle(){if root.enabled{root.checked=!root.checked;root.toggled();}}
    Rectangle {x:-3px;y:(parent.height - 22px)/2;width:22px;height:22px;border-radius:7px;background:transparent;border-width:keys.has-focus?1px:0px;border-color:AppColors.accent;}
    Rectangle {x:0px;y:(parent.height - 16px)/2;width:16px;height:16px;border-radius:5px;border-width:1.5px;border-color:root.checked||root.indeterminate?AppColors.accent:AppColors.muted.with-alpha(0.55);background:root.checked||root.indeterminate?AppColors.accent:AppColors.field;
        transform-origin:{x:self.width/2,y:self.height/2};transform-scale:AppColors.motion&&touch.pressed?0.9:1;
        animate background,border-color {duration:AppColors.motion?160ms:0ms;}animate transform-scale {duration:AppColors.motion?200ms:0ms;easing:cubic-bezier(0.16,1,0.3,1);}
        Image {visible:!root.indeterminate;x:2px;y:2px;width:12px;height:12px;source:@image-url("icons/check.svg");colorize:AppColors.on-accent;opacity:root.checked?1:0;transform-origin:{x:self.width/2,y:self.height/2};transform-scale:root.checked?1:0.4;animate opacity {duration:AppColors.motion?100ms:0ms;}animate transform-scale {duration:AppColors.motion?220ms:0ms;easing:cubic-bezier(0.2,1.4,0.4,1);}}
        Rectangle {visible:root.indeterminate;x:4px;y:7px;width:8px;height:2px;border-radius:1px;background:AppColors.on-accent;}
    }
    caption:=Text {visible:root.text!="";x:24px;width:parent.width - 24px;height:parent.height;text:root.text;font-size:13px;color:AppColors.ink;vertical-alignment:center;}
    keys:=FocusScope {enabled:root.enabled;key-pressed(event)=>{if event.text==Key.Return||event.text==" "{root.toggle();return accept;}return reject;}}
    touch:=TouchArea {enabled:root.enabled;clicked=>{keys.focus();root.toggle();}}
}
