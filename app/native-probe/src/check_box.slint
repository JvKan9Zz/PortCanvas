import {AppColors} from "action_button.slint";
export component CheckBox inherits Rectangle {
    in-out property <bool> checked:false;in property <bool> indeterminate:false;
    in property <string> text;in property <bool> enabled:true;callback toggled();
    height:24px;vertical-stretch:0;preferred-width:root.text==""?16px:caption.preferred-width+24px;
    background:transparent;forward-focus:keys;
    accessible-role:checkbox;accessible-label:root.text;accessible-enabled:root.enabled;accessible-checkable:true;accessible-checked:root.checked;accessible-action-default=>{root.toggle();}
    function toggle(){if root.enabled{root.checked=!root.checked;root.toggled();}}
    property <float> stroke-phase:root.checked?1:0;
    animate stroke-phase {duration:AppColors.motion?(root.checked?200ms:120ms):0ms;easing:ease-in-out;}
    Rectangle {x:-3px;y:(parent.height - 22px)/2;width:22px;height:22px;border-radius:7px;background:transparent;border-width:keys.has-focus?1px:0px;border-color:AppColors.accent;}
    Rectangle {x:0px;y:(parent.height - 16px)/2;width:16px;height:16px;border-radius:5px;border-width:1.5px;border-color:root.checked||root.indeterminate?(root.enabled?AppColors.accent:AppColors.accent.with-alpha(0.45)):AppColors.muted.with-alpha(root.enabled?0.55:0.3);background:root.checked||root.indeterminate?(root.enabled?AppColors.accent:AppColors.accent.with-alpha(0.45)):(root.enabled?AppColors.field:AppColors.inset);
        transform-origin:{x:self.width/2,y:self.height/2};transform-scale:AppColors.motion&&touch.pressed?0.9:1;
        animate background,border-color {duration:AppColors.motion?160ms:0ms;}animate transform-scale {duration:AppColors.motion?200ms:0ms;easing:cubic-bezier(0.16,1,0.3,1);}
        Path {visible:!root.indeterminate&&root.stroke-phase>0;width:16px;height:16px;viewbox-width:16;viewbox-height:16;fill:transparent;stroke:root.enabled?AppColors.on-accent:AppColors.on-accent.with-alpha(0.6);stroke-width:1.8px;stroke-line-cap:round;stroke-line-join:round;
            property <float> first:min(1,root.stroke-phase/0.3);property <float> second:max(0,(root.stroke-phase - 0.3)/0.7);
            commands:"M3.5 8 L"+(3.5+3*self.first)+" "+(8+3*self.first)+(root.stroke-phase>0.3?" L"+(6.5+6.5*self.second)+" "+(11 - 7*self.second):"");
        }
        Rectangle {visible:root.indeterminate;x:4px;y:7px;width:8px;height:2px;border-radius:1px;background:root.enabled?AppColors.on-accent:AppColors.on-accent.with-alpha(0.6);}
    }
    caption:=Text {visible:root.text!="";x:24px;width:parent.width - 24px;height:parent.height;text:root.text;font-size:13px;color:root.enabled?AppColors.ink:AppColors.muted.with-alpha(0.6);vertical-alignment:center;}
    keys:=FocusScope {enabled:root.enabled;key-pressed(event)=>{if event.text==Key.Return||event.text==" "{root.toggle();return accept;}return reject;}}
    touch:=TouchArea {enabled:root.enabled;clicked=>{keys.focus();root.toggle();}}
}
