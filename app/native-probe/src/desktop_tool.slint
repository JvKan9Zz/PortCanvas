import {Palette} from "std-widgets.slint";
import {AppColors} from "action_button.slint";
import {ToolHint} from "tool_hint.slint";
export component DesktopTool inherits Rectangle {
    in property <string> text;
    in property <string> label:root.text;
    in property <image> icon;
    in property <bool> show-text:true;
    in property <bool> has-icon:true;
    in property <bool> icon-end:false;
    in property <bool> checked:false;
    in property <bool> checkable:false;
    in property <bool> enabled:true;
    in property <bool> danger:false;
    in property <bool> surfaced:false;
    in property <bool> elastic:true;
    in property <bool> caption-button:false;
    in property <angle> icon-angle:0deg;
    callback clicked();
    property <bool> hint-shown:false;
    property <int> hint-ticket:-1;
    function hide-hint(){if root.hint-ticket==ToolHint.ticket{ToolHint.clear();}root.hint-shown=false;}
    changed show-text=>{root.hide-hint();}
    changed label=>{root.hide-hint();}
    min-width:30px;preferred-height:30px;vertical-stretch:0;horizontal-stretch:0;
    preferred-width:(root.has-icon?20px:0px)+(root.show-text?caption.preferred-width:0px)+(root.has-icon&&root.show-text?6px:0px)+20px;
    property <bool> caption-close-active:root.caption-button&&root.danger&&(touch.has-hover||touch.pressed);
    property <length> icon-size:root.caption-button?14px:20px;
    border-radius:9px;border-width:root.surfaced||(root.caption-button&&keys.has-focus)?1px:0px;
    border-color:root.caption-button&&keys.has-focus?AppColors.accent:AppColors.edge;
    background:root.caption-close-active?(AppColors.high-contrast?Palette.accent-background:touch.pressed?#a62f37:#bd3e48):root.checked||(root.enabled&&touch.pressed)?AppColors.soft:root.surfaced?(root.enabled&&touch.has-hover?AppColors.soft:AppColors.surface):root.enabled&&touch.has-hover?AppColors.field:transparent;
    animate background,border-color {duration:AppColors.motion?150ms:0ms;}
    transform-origin:{x:self.width/2,y:self.height/2};transform-scale:AppColors.motion&&root.elastic&&root.enabled&&touch.pressed?0.94:1;animate transform-scale {duration:AppColors.motion&&root.elastic?(touch.pressed?90ms:280ms):0ms;easing:touch.pressed?cubic-bezier(0.16,1,0.3,1):cubic-bezier(0.2,2.4,0.4,1);}
    accessible-role:button;accessible-label:root.label;accessible-enabled:root.enabled;
    accessible-checkable:root.checkable;accessible-checked:root.checked;
    accessible-action-default=>{if root.enabled{root.clicked();}}
    forward-focus:keys;
    Image {visible:root.has-icon;source:root.icon;image-fit:contain;x:!root.show-text?(parent.width - root.icon-size)/2:root.icon-end?parent.width - 30px:10px;y:(parent.height - root.icon-size)/2;width:root.icon-size;height:root.icon-size;colorize:!root.enabled?AppColors.muted.with-alpha(root.surfaced?0.82:0.45):root.caption-close-active?AppColors.on-accent:root.caption-button?AppColors.ink:root.danger?AppColors.danger:root.checked?AppColors.accent:root.surfaced?AppColors.ink:AppColors.muted;transform-rotation:root.icon-angle;animate transform-rotation {duration:AppColors.motion?260ms:0ms;easing:cubic-bezier(0.16,1,0.3,1);}}
    caption:=Text {visible:root.show-text;x:root.has-icon&&!root.icon-end?36px:10px;width:parent.width - 20px - (root.has-icon?26px:0px);height:parent.height;text:root.text;color:!root.enabled?AppColors.muted.with-alpha(0.6):root.danger?AppColors.danger:root.checked&&!AppColors.dark?AppColors.accent:AppColors.ink;font-size:12px;vertical-alignment:center;}
    keys:=FocusScope {enabled:root.enabled;key-pressed(event)=>{if event.text==Key.Return||event.text==" "{root.clicked();return accept;}return reject;}}
    touch:=TouchArea {enabled:root.enabled||!root.show-text;
        changed has-hover=>{if !self.has-hover{root.hide-hint();}}
        changed pressed=>{if self.pressed{root.hide-hint();}}
        clicked=>{root.hide-hint();if root.enabled{keys.focus();root.clicked();}}
    }
    Timer {interval:650ms;running:touch.has-hover&&!touch.pressed&&!root.show-text&&root.label!=""&&!root.hint-shown;
        triggered=>{
            ToolHint.clear();root.hint-ticket=ToolHint.ticket;root.hint-shown=true;
            ToolHint.anchor-x=touch.absolute-position.x;ToolHint.anchor-y=touch.absolute-position.y;
            ToolHint.anchor-width=root.width;ToolHint.anchor-height=root.height;ToolHint.text=root.label;
        }
    }
}
