import {Palette} from "std-widgets.slint";
import {AppColors} from "action_button.slint";
export component DesktopTool inherits Rectangle {
    in property <string> text;
    in property <string> label:root.text;
    in property <image> icon;
    in property <bool> show-text:true;
    in property <bool> has-icon:true;
    in property <bool> icon-end:false;
    in property <bool> checked:false;
    in property <bool> checkable:false;
    in property <bool> enabled:true;
    in property <bool> danger:false;
    callback clicked();
    min-width:34px;preferred-height:36px;vertical-stretch:0;horizontal-stretch:0;
    preferred-width:(root.has-icon?20px:0px)+(root.show-text?caption.preferred-width:0px)+(root.has-icon&&root.show-text?6px:0px)+20px;
    border-radius:9px;border-width:keys.has-focus?2px:1px;
    border-color:keys.has-focus?Palette.foreground:root.checked?AppColors.accent.with-alpha(0.45):transparent;
    background:root.checked?AppColors.accent.with-alpha(0.12):touch.has-hover?Palette.control-background:transparent;
    opacity:root.enabled?1:0.45;
    accessible-role:button;accessible-label:root.label;accessible-enabled:root.enabled;
    accessible-checkable:root.checkable;accessible-checked:root.checked;
    accessible-action-default=>{if root.enabled{root.clicked();}}
    forward-focus:keys;
    Image {visible:root.has-icon;source:root.icon;image-fit:contain;x:root.icon-end?parent.width - 30px:10px;y:(parent.height - 20px)/2;width:20px;height:20px;colorize:root.danger?Palette.foreground.mix(#d34b4b,0.45):root.checked?AppColors.accent:Palette.foreground;}
    caption:=Text {visible:root.show-text;x:root.has-icon&&!root.icon-end?36px:10px;width:parent.width - 20px - (root.has-icon?26px:0px);height:parent.height;text:root.text;color:root.checked&&Palette.color-scheme==ColorScheme.light?AppColors.accent:Palette.foreground;vertical-alignment:center;}
    keys:=FocusScope {enabled:root.enabled;key-pressed(event)=>{if event.text==Key.Return||event.text==" "{root.clicked();return accept;}return reject;}}
    touch:=TouchArea {enabled:root.enabled;clicked=>{keys.focus();root.clicked();}}
}
