import {Button,LineEdit,CheckBox,ComboBox,ListView,HorizontalBox,VerticalBox,Palette} from "std-widgets.slint";
import {ActionButton} from "action_button.slint";
export struct FileRow {name:string,kind:string,size:string,modified:string,selected:bool,directory:bool}
component FileCheck inherits CheckBox {
    in property <bool> selected;checked:root.selected;
    changed selected=>{self.checked=root.selected;}
    callback choose();toggled=>{root.choose();}
}
export component FilePane inherits VerticalBox {
    in property <bool> english;in property <bool> remote;in property <bool> enabled:true;
    in property <bool> loading;in property <bool> loaded;in property <bool> connected;
    in property <[FileRow]> rows;in property <string> message;
    in-out property <string> path;in-out property <string> folder;
    pure callback tr(string,bool)->string;
    callback action(string);callback choose(int,bool,bool);callback all(bool);callback open(int);
    padding:0px;spacing:6px;
    HorizontalBox {height:32px;vertical-stretch:0;padding:0px;
        Text {text:root.tr(root.remote?"远端":"本地",root.english);color:Palette.foreground;font-weight:600;}
        if root.remote&&!root.connected:Button {text:root.tr("连接设备",root.english);clicked=>{root.action("connect");}}
        if !root.remote:Button {text:root.tr("选择文件夹",root.english);enabled:root.enabled;clicked=>{root.action("choose");}}
    }
    HorizontalBox {height:34px;vertical-stretch:0;padding:0px;
        LineEdit {accessible-label:root.tr(root.remote?"远端目录":"本地目录",root.english);text<=>root.path;enabled:root.enabled;accepted=>{root.action("go");}}
        Button {text:root.tr("转到",root.english);enabled:root.enabled;clicked=>{root.action("go");}}
    }
    HorizontalBox {height:34px;vertical-stretch:0;padding:0px;
        Button {text:root.tr("上级",root.english);enabled:root.enabled&&root.loaded;clicked=>{root.action("up");}}
        Button {text:root.tr("主目录",root.english);enabled:root.enabled;clicked=>{root.action("home");}}
        Button {text:root.tr("刷新",root.english);enabled:root.enabled;clicked=>{root.action("refresh");}}
        Button {text:root.tr("全选",root.english);enabled:root.enabled&&root.rows.length>0;clicked=>{root.all(true);}}
        Button {text:root.tr("清除选择",root.english);enabled:root.enabled&&root.rows.length>0;clicked=>{root.all(false);}}
    }
    Rectangle {background:Palette.background;border-width:1px;border-color:Palette.border;
        list:=ListView {x:1px;y:1px;width:parent.width - 2px;height:parent.height - 2px;
            for row[index] in root.rows:item:=Rectangle {
                height:38px;background:row.selected?Palette.alternate-background:Palette.background;
                border-width:keys.has-focus?1px:0px;border-color:Palette.foreground;
                property <bool> additive;property <bool> range;
                forward-focus:keys;
                accessible-role:list-item;accessible-label:row.name;accessible-action-default=>{root.choose(index,false,false);}
                keys:=FocusScope {enabled:root.enabled;key-pressed(event)=>{
                    if event.text==Key.Return{root.open(index);return accept;}
                    if event.text==" "{root.choose(index,event.modifiers.control,event.modifiers.shift);return accept;}
                    return reject;
                }}
                HorizontalBox {padding:2px;spacing:6px;
                    FileCheck {selected:row.selected;accessible-label:root.tr("选择 "+row.name,root.english);enabled:root.enabled;min-width:28px;horizontal-stretch:0;choose=>{root.choose(index,true,false);}}
                    Text {text:row.name;color:Palette.foreground;overflow:elide;}
                    Text {text:row.directory?root.tr("文件夹",root.english):row.kind==root.tr("链接",root.english)?row.kind:row.size;color:Palette.foreground;min-width:65px;preferred-width:75px;horizontal-stretch:0;overflow:elide;horizontal-alignment:right;}
                    Text {text:row.modified;color:Palette.foreground;preferred-width:92px;horizontal-stretch:0;overflow:elide;}
                }
                TouchArea {x:36px;width:parent.width - 36px;enabled:root.enabled;
                    pointer-event(event)=>{if event.kind==PointerEventKind.down{item.additive=event.modifiers.control;item.range=event.modifiers.shift;}}
                    clicked=>{keys.focus();root.choose(index,item.additive,item.range);}
                    double-clicked=>{root.open(index);}
                }
            }
        }
    }
    Text {text:root.message;color:Palette.foreground;wrap:word-wrap;vertical-stretch:0;}
    HorizontalBox {height:34px;vertical-stretch:0;padding:0px;
        LineEdit {accessible-label:root.tr(root.remote?"远端新文件夹名称":"本地新文件夹名称",root.english);text<=>root.folder;enabled:root.enabled&&root.loaded;accepted=>{root.action("mkdir");}}
        Button {text:root.tr("新建文件夹",root.english);enabled:root.enabled&&root.loaded&&root.folder!="";clicked=>{root.action("mkdir");}}
    }
}
export component FilesView inherits VerticalBox {
    in property <bool> english;in property <bool> enabled;in property <bool> connected;in property <bool> busy;
    in property <[FileRow]> local-rows;in property <[FileRow]> remote-rows;
    in-out property <string> local-path;in-out property <string> remote-path;
    in-out property <string> local-folder;in-out property <string> remote-folder;
    in property <string> local-message;in property <string> remote-message;
    in property <bool> local-loading;in property <bool> remote-loading;
    in property <bool> local-loaded;in property <bool> remote-loaded;
    in property <int> local-selected;in property <int> remote-selected;
    in property <string> status;in property <string> current;in property <string> numbers;in property <string> error;
    in property <float> progress;in-out property <int> rate;
    pure callback tr(string,bool)->string;
    callback action(int,string);callback choose(int,int,bool,bool);callback all(int,bool);callback open(int,int);
    property <bool> can-browse:root.enabled&&!root.busy&&!root.local-loading&&!root.remote-loading;
    padding:0px;spacing:8px;
    HorizontalBox {padding:0px;
        FilePane {english:root.english;remote:false;enabled:root.can-browse;connected:root.connected;rows:root.local-rows;path<=>root.local-path;folder<=>root.local-folder;message:root.local-message;loading:root.local-loading;loaded:root.local-loaded;
            tr(s,e)=>{return root.tr(s,e);}action(a)=>{root.action(0,a);}choose(n,c,s)=>{root.choose(0,n,c,s);}all(c)=>{root.all(0,c);}open(n)=>{root.open(0,n);}}
        FilePane {english:root.english;remote:true;enabled:root.can-browse&&root.connected;connected:root.connected;rows:root.remote-rows;path<=>root.remote-path;folder<=>root.remote-folder;message:root.remote-message;loading:root.remote-loading;loaded:root.remote-loaded;
            tr(s,e)=>{return root.tr(s,e);}action(a)=>{root.action(1,a);}choose(n,c,s)=>{root.choose(1,n,c,s);}all(c)=>{root.all(1,c);}open(n)=>{root.open(1,n);}}
    }
    HorizontalBox {height:36px;vertical-stretch:0;padding:0px;
        ActionButton {text:root.tr("上传",root.english);primary:true;enabled:root.can-browse&&root.connected&&root.remote-loaded&&root.local-selected>0;clicked=>{root.action(0,"upload");}}
        ActionButton {text:root.tr("下载",root.english);primary:true;enabled:root.can-browse&&root.connected&&root.local-loaded&&root.remote-selected>0;clicked=>{root.action(1,"download");}}
        Button {text:root.tr("删除远端所选",root.english);enabled:root.can-browse&&root.connected&&root.remote-selected>0;clicked=>{root.action(1,"delete");}}
        ComboBox {accessible-label:root.tr("传输限速",root.english);model:[root.tr("不限速",root.english),"1 MiB/s","5 MiB/s","10 MiB/s"];current-index<=>root.rate;enabled:root.enabled&&!root.busy;}
        Button {text:root.tr("取消操作",root.english);enabled:root.enabled&&root.busy;clicked=>{root.action(0,"cancel");}}
    }
    if root.status!="":Text {text:root.status;color:Palette.foreground;wrap:word-wrap;vertical-stretch:0;}
    if root.current!="":Text {text:root.current;color:Palette.foreground;overflow:elide;vertical-stretch:0;}
    if root.status!="":Rectangle {height:5px;vertical-stretch:0;background:Palette.border;Rectangle {width:parent.width*min(1,max(0,root.progress));background:Palette.accent-background;}}
    if root.numbers!="":Text {text:root.numbers;color:Palette.foreground;vertical-stretch:0;}
    if root.error!="":Text {text:root.error;color:#d34b4b;wrap:word-wrap;vertical-stretch:0;}
}
