import {CheckBox} from "check_box.slint";
import {DesktopTool} from "desktop_tool.slint";
import {FormInput as LineEdit} from "form_input.slint";
import {SelectBox as ComboBox} from "select_box.slint";
import {ListView,HorizontalBox,VerticalBox,Palette} from "std-widgets.slint";
import {ActionButton,ActionButton as Button,AppColors,ActivityIndicator} from "action_button.slint";
export struct FileRow {name:string,kind:string,size:string,modified:string,selected:bool,directory:bool}
export struct FileArea {x:float,y:float,width:float,height:float,offset:float}
component FileCheck inherits CheckBox {
    in property <bool> selected;checked:root.selected;
    changed selected=>{self.checked=root.selected;}
    callback choose();toggled=>{root.choose();}
}
export component FilePane inherits Rectangle {
    min-width:0px;
    in property <bool> compact:false;
    in property <bool> english;in property <bool> remote;in property <bool> enabled:true;
    in property <bool> loading;in property <bool> loaded;in property <bool> connected;
    in property <[FileRow]> rows;in property <string> message;in property <int> selected-count;
    in property <[string]> drives;in-out property <int> drive-index:-1;callback drive(int);
    in property <bool> drop-active;in property <int> drop-row:-1;
    in property <string> drop-label;
    callback geometry(FileArea);
    in property <int> geometry-ticket;
    changed geometry-ticket=>{root.geometry({x:list.absolute-position.x/1px,y:list.absolute-position.y/1px,width:list.width/1px,height:list.height/1px,offset:list.viewport-y/1px});}
    in-out property <string> path;in-out property <string> folder;
    pure callback tr(string,bool)->string;
    callback action(string);callback choose(int,bool,bool);callback all(bool);callback open(int);
    border-radius:16px;border-width:1px;border-color:AppColors.edge;background:AppColors.card;
    horizontal-stretch:1;preferred-width:0px;
    VerticalBox {padding:0px;spacing:6px;
    HorizontalBox {height:48px;vertical-stretch:0;padding:12px;spacing:8px;
        Image {width:17px;height:17px;horizontal-stretch:0;source:root.remote?@image-url("icons/files.svg"):@image-url("icons/desktop.svg");colorize:AppColors.accent;}
        ActivityIndicator {active:root.loading;}
        Text {text:root.tr(root.remote?"远端设备":"本地电脑",root.english);color:AppColors.ink;font-weight:600;vertical-alignment:center;}
        Rectangle {horizontal-stretch:1;background:transparent;}
        if root.remote&&!root.connected:Button {text:root.tr("连接设备",root.english);clicked=>{root.action("connect");}}
        if root.remote&&root.connected:Button {text:root.tr("删除",root.english);icon:@image-url("icons/trash.svg");has-icon:true;danger:true;enabled:root.enabled&&root.selected-count>0;clicked=>{root.action("delete");}}
        if !root.remote:Button {text:root.tr("选择目录",root.english);enabled:root.enabled;clicked=>{root.action("choose");}}
    }
    Rectangle {height:1px;vertical-stretch:0;background:AppColors.edge;}
    HorizontalBox {height:32px;vertical-stretch:0;padding-left:12px;padding-right:12px;spacing:4px;
        DesktopTool {width:32px;height:32px;show-text:false;label:root.tr("上级",root.english);icon:@image-url("icons/up.svg");enabled:root.enabled&&root.loaded;clicked=>{root.action("up");}}
        DesktopTool {width:32px;height:32px;show-text:false;label:root.tr("主目录",root.english);icon:@image-url("icons/home.svg");enabled:root.enabled;clicked=>{root.action("home");}}
        DesktopTool {width:32px;height:32px;show-text:false;label:root.tr("刷新",root.english);icon:@image-url("icons/restart.svg");enabled:root.enabled;clicked=>{root.action("refresh");}}
        Rectangle {horizontal-stretch:1;background:transparent;}
        DesktopTool {height:30px;label:root.tr("新建文件夹",root.english);text:root.tr("新建文件夹",root.english);icon:@image-url("icons/plus.svg");enabled:root.enabled&&root.loaded;clicked=>{root.action("new-folder");}}
    }
    HorizontalBox {height:42px;vertical-stretch:0;padding-left:12px;padding-right:12px;spacing:4px;
        if !root.remote:ComboBox {width:76px;horizontal-stretch:0;accessible-label:root.tr("本地磁盘",root.english);model:root.drives;current-index<=>root.drive-index;enabled:root.enabled;selected(index)=>{root.drive(index);}}
        LineEdit {label:root.tr(root.remote?"远端目录":"本地目录",root.english);text<=>root.path;enabled:root.enabled;accepted=>{root.action("go");}}
        DesktopTool {width:32px;height:32px;show-text:false;label:root.tr("转到",root.english);icon:@image-url("icons/go.svg");enabled:root.enabled;clicked=>{root.action("go");}}
    }
    HorizontalBox {height:32px;vertical-stretch:0;padding-left:12px;padding-right:12px;spacing:6px;
        CheckBox {accessible-label:root.tr("全选",root.english);checked:root.rows.length>0&&root.selected-count==root.rows.length;indeterminate:root.selected-count>0&&root.selected-count<root.rows.length;enabled:root.enabled&&root.rows.length>0;toggled=>{root.all(self.checked);}width:28px;horizontal-stretch:0;}
        Rectangle {width:16px;horizontal-stretch:0;background:transparent;}
        Text {text:root.tr("名称",root.english);color:AppColors.ink;vertical-alignment:center;min-width:0px;preferred-width:0px;horizontal-stretch:1;}
        Text {text:root.tr("大小",root.english);color:AppColors.ink;vertical-alignment:center;width:75px;horizontal-stretch:0;horizontal-alignment:right;}
        if !root.compact:Text {text:root.tr("修改时间",root.english);color:AppColors.ink;vertical-alignment:center;width:92px;horizontal-stretch:0;horizontal-alignment:right;}
    }
    Rectangle {background:transparent;border-width:root.drop-active?2px:0px;border-color:AppColors.edge;
        list:=ListView {x:1px;y:1px;width:parent.width - 2px;height:parent.height - 2px;vertical-scrollbar-policy:always-off;horizontal-scrollbar-policy:always-off;
            for row[index] in root.rows:item:=Rectangle {
                height:40px;background:row.selected?AppColors.soft:row-touch.has-hover?AppColors.field:transparent;
                border-width:root.drop-active&&root.drop-row==index?2px:0px;border-color:AppColors.edge;
                property <bool> additive;property <bool> range;
                forward-focus:keys;
                accessible-role:list-item;accessible-label:row.name;accessible-action-default=>{root.choose(index,false,false);}
                keys:=FocusScope {enabled:root.enabled;key-pressed(event)=>{
                    if event.text==Key.Return{root.open(index);return accept;}
                    if event.text==" "{root.choose(index,event.modifiers.control,event.modifiers.shift);return accept;}
                    return reject;
                }}
                HorizontalBox {padding-left:12px;padding-right:12px;padding-top:2px;padding-bottom:2px;spacing:6px;
                    FileCheck {selected:row.selected;accessible-label:root.tr("选择 "+row.name,root.english);enabled:root.enabled;width:28px;horizontal-stretch:0;choose=>{root.choose(index,true,false);}}
                    Image {width:16px;height:16px;horizontal-stretch:0;source:row.directory?@image-url("icons/files.svg"):row.kind==root.tr("链接",root.english)?@image-url("icons/connect.svg"):@image-url("icons/file.svg");colorize:AppColors.accent;}
                    Text {text:row.name;color:AppColors.ink;overflow:elide;min-width:0px;preferred-width:0px;horizontal-stretch:1;}
                    Text {text:row.directory?root.tr("文件夹",root.english):row.kind==root.tr("链接",root.english)?row.kind:row.size;color:AppColors.muted;width:75px;horizontal-stretch:0;overflow:elide;horizontal-alignment:right;}
                    if !root.compact:Text {text:row.modified;color:AppColors.muted;width:92px;horizontal-stretch:0;overflow:elide;horizontal-alignment:right;}
                }
                Rectangle {y:parent.height - 1px;width:parent.width;height:1px;background:AppColors.edge;}
                row-touch:=TouchArea {x:42px;width:parent.width - 36px;enabled:root.enabled;
                    pointer-event(event)=>{if event.kind==PointerEventKind.down{item.additive=event.modifiers.control;item.range=event.modifiers.shift;}}
                    clicked=>{keys.focus();root.choose(index,item.additive,item.range);}
                    double-clicked=>{root.open(index);}
                }
            }
        }
    }
    Rectangle {height:max(32px,footer.preferred-height + 12px);vertical-stretch:0;background:transparent;
        footer:=Text {x:12px;y:6px;width:parent.width - 24px;height:parent.height - 12px;text:root.message;color:AppColors.muted;font-size:11px;wrap:word-wrap;vertical-alignment:center;}
    }
    }
}
export component FilesView inherits VerticalBox {
    in property <bool> compact:false;
    property <int> pane-side:0;
    function invalidate-hidden() {if root.compact {root.geometry(root.pane-side==0?1:0,{x:0,y:0,width:0,height:0,offset:0});}}
    changed compact=>{root.invalidate-hidden();}
    changed pane-side=>{root.invalidate-hidden();}
    in property <bool> english;in property <bool> enabled;in property <bool> connected;in property <bool> busy;
    in property <[FileRow]> local-rows;in property <[FileRow]> remote-rows;
    in property <[string]> drives;in-out property <int> drive-index:-1;callback drive(int);
    callback geometry(int,FileArea);
    in property <int> geometry-ticket;
    in property <int> drop-side:-1;in property <int> drop-row:-1;in property <string> drop-label;
    in-out property <string> local-path;in-out property <string> remote-path;
    in-out property <string> local-folder;in-out property <string> remote-folder;
    in property <string> local-message;in property <string> remote-message;
    in property <bool> local-loading;in property <bool> remote-loading;
    in property <bool> local-loaded;in property <bool> remote-loaded;
    in property <int> local-selected;in property <int> remote-selected;
    in property <string> status;in property <string> current;in property <string> numbers;in property <string> error;
    in property <float> progress;in-out property <int> rate;
    pure callback tr(string,bool)->string;
    callback action(int,string);callback choose(int,int,bool,bool);callback all(int,bool);callback open(int,int);
    changed geometry-ticket=>{root.invalidate-hidden();}
    property <bool> can-browse:root.enabled&&!root.busy&&!root.local-loading&&!root.remote-loading;
    min-width:0px;padding:0px;spacing:8px;
    HorizontalBox {height:36px;vertical-stretch:0;padding:0px;spacing:8px;
        ActionButton {text:root.tr(root.compact?"上传":"上传至远端设备",root.english);icon:@image-url("icons/upload.svg");has-icon:true;primary:true;enabled:root.can-browse&&root.connected&&root.remote-loaded&&root.local-selected>0;clicked=>{root.action(0,"upload");}}
        ActionButton {text:root.tr(root.compact?"下载":"下载至电脑",root.english);icon:@image-url("icons/download.svg");has-icon:true;enabled:root.can-browse&&root.connected&&root.local-loaded&&root.remote-selected>0;clicked=>{root.action(1,"download");}}
        Rectangle {background:transparent;horizontal-stretch:1;}
        Text {text:root.tr("传输限速",root.english);font-size:11px;color:AppColors.muted;vertical-alignment:center;horizontal-stretch:0;}
        ComboBox {width:100px;horizontal-stretch:0;accessible-label:root.tr("传输限速",root.english);model:[root.tr("不限速",root.english),"1 MiB/s","5 MiB/s","10 MiB/s"];current-index<=>root.rate;enabled:root.enabled&&!root.busy;}
        if root.busy:Button {text:root.tr("取消操作",root.english);enabled:root.enabled;clicked=>{root.action(0,"cancel");}}
    }
    if root.compact:HorizontalBox {padding:0px;vertical-stretch:0;
        ActionButton {text:root.tr("本地",root.english);selected:root.pane-side==0;accessible-checkable:true;accessible-checked:root.pane-side==0;clicked=>{root.pane-side=0;}}
        ActionButton {text:root.tr("远端",root.english);selected:root.pane-side==1;accessible-checkable:true;accessible-checked:root.pane-side==1;clicked=>{root.pane-side=1;}}
    }
    HorizontalBox {padding:0px;spacing:14px;
        if !root.compact||root.pane-side==0:FilePane {compact:root.compact;english:root.english;remote:false;enabled:root.can-browse;connected:root.connected;rows:root.local-rows;selected-count:root.local-selected;path<=>root.local-path;folder<=>root.local-folder;message:root.local-message;loading:root.local-loading;loaded:root.local-loaded;
            geometry-ticket:root.geometry-ticket;drives:root.drives;drive-index<=>root.drive-index;drive(n)=>{root.drive(n);}geometry(a)=>{root.geometry(0,a);}drop-active:root.drop-side==0;drop-row:root.drop-row;drop-label:root.drop-label;
            tr(s,e)=>{return root.tr(s,e);}action(a)=>{root.action(0,a);}choose(n,c,s)=>{root.choose(0,n,c,s);}all(c)=>{root.all(0,c);}open(n)=>{root.open(0,n);}}
        if !root.compact||root.pane-side==1:FilePane {compact:root.compact;english:root.english;remote:true;enabled:root.can-browse&&root.connected;connected:root.connected;rows:root.remote-rows;selected-count:root.remote-selected;path<=>root.remote-path;folder<=>root.remote-folder;message:root.remote-message;loading:root.remote-loading;loaded:root.remote-loaded;
            geometry-ticket:root.geometry-ticket;geometry(a)=>{root.geometry(1,a);}drop-active:root.drop-side==1;drop-row:root.drop-row;drop-label:root.drop-label;
            tr(s,e)=>{return root.tr(s,e);}action(a)=>{root.action(1,a);}choose(n,c,s)=>{root.choose(1,n,c,s);}all(c)=>{root.all(1,c);}open(n)=>{root.open(1,n);}}
    }
    if root.status!="":Text {text:root.status;color:AppColors.ink;wrap:word-wrap;vertical-stretch:0;}
    if root.current!="":Text {text:root.current;color:AppColors.ink;overflow:elide;vertical-stretch:0;}
    if root.status!="":Rectangle {height:5px;vertical-stretch:0;border-radius:3px;background:AppColors.edge;Rectangle {x:0px;y:0px;width:parent.width*min(1,max(0,root.progress));background:AppColors.accent;animate width {duration:AppColors.motion?160ms:0ms;easing:linear;}}}
    if root.numbers!="":Text {text:root.numbers;color:AppColors.ink;vertical-stretch:0;}
    if root.error!="":Text {text:root.error;color:#d34b4b;wrap:word-wrap;vertical-stretch:0;}
}
