import {Palette,VerticalBox} from "std-widgets.slint";
import {AppColors} from "action_button.slint";
export component MaterialPanel inherits Rectangle {
    in property <image> material;
    in property <bool> active;
    in property <float> strength:100;
    in property <bool> solid:false;
    border-radius:24px;clip:true;
    background:root.solid?AppColors.surface:AppColors.surface.with-alpha((AppColors.dark?0.24:0.22)+0.58*root.strength/100);
    border-width:1px;border-color:AppColors.dark?#b7cced24:#ffffffeb;
    drop-shadow-offset-y:8px;drop-shadow-blur:28px;drop-shadow-color:AppColors.dark?#00000026:#2d436e14;
    if root.active:Image {width:parent.width;height:parent.height;source:root.material;image-fit:fill;}
    @children
}
export component NavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> enabled:true;
    in property <bool> shared-selection:false;
    callback clicked();
    preferred-height:64px;min-height:64px;vertical-stretch:0;
    border-radius:17px;
    background:touch.pressed?AppColors.soft:root.selected&&!root.shared-selection?AppColors.soft:transparent;
    transform-origin:{x:self.width/2,y:self.height/2};transform-scale:AppColors.motion&&touch.pressed?0.96:1;animate transform-scale {duration:AppColors.motion?180ms:0ms;easing:cubic-bezier(0.16,1,0.3,1);}
    border-width:keys.has-focus?1px:0px;border-color:AppColors.accent;
    animate background {duration:AppColors.motion?160ms:0ms;}
    opacity:root.enabled?1:0.45;
    accessible-role:button;accessible-label:root.text;accessible-enabled:root.enabled;
    accessible-checkable:true;accessible-checked:root.selected;
    accessible-action-default=>{if root.enabled{root.clicked();}}
    forward-focus:keys;
    VerticalBox {padding:6px;spacing:3px;alignment:center;
        Image {source:root.icon;image-fit:contain;preferred-width:22px;preferred-height:22px;horizontal-stretch:0;vertical-stretch:0;colorize:root.selected&&!AppColors.dark?AppColors.accent:Palette.foreground;}
        Text {text:root.text;color:root.selected?AppColors.accent-ink:AppColors.muted;font-size:11px;font-weight:500;horizontal-alignment:center;vertical-stretch:0;}
    }
    keys:=FocusScope {enabled:root.enabled;key-pressed(event)=>{if event.text==Key.Return||event.text==" "{root.clicked();return accept;}return reject;}}
    touch:=TouchArea {enabled:root.enabled;clicked=>{keys.focus();root.clicked();}}
}
export component DeviceListItem inherits Rectangle {
    in property <string> name;
    in property <string> address;
    in property <bool> selected;
    in property <bool> enabled:true;
    callback clicked();
    height:92px;vertical-stretch:0;
    border-radius:10px;
    background:root.selected?AppColors.field:touch.has-hover?Palette.control-background:transparent;
    border-width:keys.has-focus?2px:1px;
    border-color:keys.has-focus?AppColors.accent:root.selected?AppColors.accent.with-alpha(0.35):transparent;
    animate background,border-color {duration:AppColors.motion?160ms:0ms;}
    opacity:root.enabled?1:0.45;
    accessible-role:button;accessible-label:root.name+" "+root.address;accessible-enabled:root.enabled;
    accessible-checkable:true;accessible-checked:root.selected;
    accessible-action-default=>{if root.enabled{root.clicked();}}
    forward-focus:keys;
    Image {x:14px;y:19px;width:16px;height:16px;source:@image-url("icons/about.svg");colorize:AppColors.accent;}
    Text {x:42px;y:14px;width:parent.width - 54px;height:44px;text:root.name;color:root.selected?AppColors.accent-ink:AppColors.ink;font-size:13px;font-weight:500;wrap:char-wrap;overflow:clip;}
    Text {x:42px;y:60px;width:parent.width - 54px;height:16px;text:root.address;color:AppColors.muted;overflow:elide;font-size:11px;}
    keys:=FocusScope {enabled:root.enabled;key-pressed(event)=>{if event.text==Key.Return||event.text==" "{root.clicked();return accept;}return reject;}}
    touch:=TouchArea {enabled:root.enabled;clicked=>{keys.focus();root.clicked();}}
}
export component ConnectionBadge inherits Rectangle {
    in property <string> text;in property <int> phase;
    property <color> tone:root.phase==2?(AppColors.dark?#a9dcc3:#35745b):root.phase==3?AppColors.danger:AppColors.muted;
    preferred-width:caption.preferred-width + 30px;height:28px;preferred-height:28px;horizontal-stretch:0;vertical-stretch:0;
    border-radius:14px;border-width:1px;border-color:root.tone.with-alpha(0.12);background:root.tone.with-alpha(0.06);
    Rectangle {x:10px;y:(parent.height - 5px)/2;width:5px;height:5px;border-radius:3px;background:root.tone;}
    caption:=Text {x:21px;width:parent.width - 29px;height:parent.height;text:root.text;font-size:11px;color:root.tone;vertical-alignment:center;}
}
