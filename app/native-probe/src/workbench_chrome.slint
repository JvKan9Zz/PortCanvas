import {Palette,VerticalBox} from "std-widgets.slint";
import {AppColors} from "action_button.slint";
export component MaterialPanel inherits Rectangle {
    in property <image> material;
    in property <bool> active;
    in property <float> strength:100;
    border-radius:20px;clip:true;
    background:Palette.background.with-alpha(0.76+0.18*root.strength/100);
    border-width:1px;border-color:Palette.border;
    if root.active:Image {width:parent.width;height:parent.height;source:root.material;image-fit:fill;}
    @children
}
export component NavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> enabled:true;
    callback clicked();
    preferred-height:64px;min-height:64px;vertical-stretch:0;
    border-radius:14px;
    background:root.selected?AppColors.accent:touch.has-hover?Palette.control-background:transparent;
    border-width:keys.has-focus?2px:0px;border-color:Palette.foreground;
    opacity:root.enabled?1:0.45;
    accessible-role:button;accessible-label:root.text;accessible-enabled:root.enabled;
    accessible-checkable:true;accessible-checked:root.selected;
    accessible-action-default=>{if root.enabled{root.clicked();}}
    forward-focus:keys;
    VerticalBox {padding:6px;spacing:3px;alignment:center;
        Image {source:root.icon;image-fit:contain;preferred-width:22px;preferred-height:22px;horizontal-stretch:0;vertical-stretch:0;colorize:root.selected?#ffffff:Palette.foreground;}
        Text {text:root.text;color:root.selected?#ffffff:Palette.foreground;font-size:12px;horizontal-alignment:center;vertical-stretch:0;}
    }
    keys:=FocusScope {enabled:root.enabled;key-pressed(event)=>{if event.text==Key.Return||event.text==" "{root.clicked();return accept;}return reject;}}
    touch:=TouchArea {enabled:root.enabled;clicked=>{keys.focus();root.clicked();}}
}
