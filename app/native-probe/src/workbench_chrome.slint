import {Palette,VerticalBox} from "std-widgets.slint";
import {AppColors} from "action_button.slint";
import {ContinuousOutline} from "continuous_outline.slint";
export component MaterialPanel inherits Rectangle {
    in property <image> material;
    in property <bool> active;
    in property <float> strength:100;
    in property <bool> solid:false;
    in property <bool> flat:false;
    border-radius:24px;clip:false;background:transparent;border-width:0px;
    drop-shadow-offset-y:8px;drop-shadow-blur:28px;drop-shadow-color:root.flat?transparent:AppColors.dark?#00000026:#2d436e14;
    if !root.flat:ContinuousOutline {x:0px;y:0px;width:parent.width;height:parent.height;radius:root.border-radius;fill:root.solid?AppColors.surface:AppColors.surface.with-alpha((AppColors.dark?0.24:0.22)+0.58*root.strength/100);}
    if root.active&&!root.flat:Image {x:0px;y:0px;width:parent.width;height:parent.height;source:root.material;image-fit:fill;}
    if !root.flat:ContinuousOutline {x:0px;y:0px;width:parent.width;height:parent.height;radius:root.border-radius;fill:transparent;stroke-width:1px;stroke:AppColors.high-contrast?AppColors.edge:AppColors.dark?#b7cced24:#ffffffeb;}
    @children
}
export component NavButton inherits Rectangle {
    in property <string> text;
    in property <image> icon;
    in property <bool> selected;
    in property <bool> enabled:true;
    in property <bool> shared-selection:false;
    callback clicked();
    preferred-height:64px;min-height:64px;vertical-stretch:0;
    border-radius:17px;
    // Shared selections have one moving plate in the parent, including on press.
    background:root.shared-selection?transparent:touch.pressed||root.selected?AppColors.soft:transparent;
    out property <float> press-scale:AppColors.motion&&touch.pressed?0.94:1;animate press-scale {duration:AppColors.motion?(touch.pressed?90ms:280ms):0ms;easing:touch.pressed?cubic-bezier(0.16,1,0.3,1):cubic-bezier(0.2,2.4,0.4,1);}
    transform-origin:{x:self.width/2,y:self.height/2};transform-scale:root.press-scale;
    border-width:0px;
    animate background {duration:AppColors.motion?160ms:0ms;}
    accessible-role:button;accessible-label:root.text;accessible-enabled:root.enabled;
    accessible-checkable:true;accessible-checked:root.selected;
    accessible-action-default=>{if root.enabled{root.clicked();}}
    forward-focus:keys;
    VerticalBox {padding:6px;spacing:3px;alignment:center;
        Image {source:root.icon;image-fit:contain;preferred-width:22px;preferred-height:22px;horizontal-stretch:0;vertical-stretch:0;colorize:!root.enabled?AppColors.muted.with-alpha(0.45):root.selected&&!AppColors.dark?AppColors.accent:Palette.foreground;}
        Text {text:root.text;color:!root.enabled?AppColors.muted.with-alpha(0.6):root.selected?AppColors.accent-ink:AppColors.muted;font-size:11px;font-weight:500;horizontal-alignment:center;vertical-stretch:0;}
    }
    keys:=FocusScope {enabled:root.enabled;key-pressed(event)=>{if event.text==Key.Return||event.text==" "{root.clicked();return accept;}return reject;}}
    touch:=TouchArea {enabled:root.enabled;clicked=>{keys.focus();root.clicked();}}
}
export component DeviceListItem inherits Rectangle {
    in property <string> name;
    in property <string> address;
    in property <bool> selected;
    in property <bool> enabled:true;
    callback clicked();
    height:80px;vertical-stretch:0;
    transform-origin:{x:self.width/2,y:self.height/2};transform-scale:AppColors.motion&&touch.pressed?0.94:1;animate transform-scale {duration:AppColors.motion?(touch.pressed?90ms:280ms):0ms;easing:touch.pressed?cubic-bezier(0.16,1,0.3,1):cubic-bezier(0.2,2.4,0.4,1);}
    border-radius:13px;
    background:root.selected?AppColors.soft:touch.has-hover?AppColors.field:AppColors.field.with-alpha(0.45);
    border-width:0px;
    animate background,border-color {duration:AppColors.motion?160ms:0ms;}
    accessible-role:button;accessible-label:root.name+" "+root.address;accessible-enabled:root.enabled;
    accessible-checkable:true;accessible-checked:root.selected;
    accessible-action-default=>{if root.enabled{root.clicked();}}
    forward-focus:keys;
    Rectangle {x:12px;y:12px;width:28px;height:28px;border-radius:9px;background:AppColors.accent.with-alpha(0.08);
        Image {x:6px;y:6px;width:16px;height:16px;source:@image-url("icons/devices.svg");colorize:AppColors.accent;}
    }
    Text {x:50px;y:12px;width:parent.width - 64px;height:28px;text:root.name;color:root.selected?AppColors.accent-ink:AppColors.ink;font-size:14px;font-weight:600;vertical-alignment:center;overflow:elide;}
    Text {x:12px;y:47px;width:parent.width - 24px;height:20px;text:root.address;color:AppColors.muted;overflow:elide;font-size:12px;vertical-alignment:center;}
    keys:=FocusScope {enabled:root.enabled;key-pressed(event)=>{if event.text==Key.Return||event.text==" "{root.clicked();return accept;}return reject;}}
    touch:=TouchArea {enabled:root.enabled;clicked=>{keys.focus();root.clicked();}}
}
export component ConnectionBadge inherits Rectangle {
    in property <string> text;in property <int> phase;
    property <color> tone:root.phase==2?(AppColors.dark?#a9dcc3:#235d42):root.phase==3?AppColors.danger:AppColors.muted;
    preferred-width:caption.preferred-width + 30px;height:28px;preferred-height:28px;horizontal-stretch:0;vertical-stretch:0;
    border-radius:14px;border-width:1px;border-color:root.tone.with-alpha(0.12);background:root.tone.with-alpha(0.06);
    Rectangle {x:10px;y:(parent.height - 5px)/2;width:5px;height:5px;border-radius:3px;background:root.tone;}
    caption:=Text {x:21px;width:parent.width - 29px;height:parent.height;text:root.text;font-size:12px;font-weight:500;color:root.tone;vertical-alignment:center;}
}
