{
  "name": "wheel-combat-studio",
  "version": "0.3.0",
  "description": "轮式格斗设备连接、远程桌面与 SFTP 文件传输",
  "author": "Wheel Combat Studio",
  "private": true,
  "main": "src/main.cjs",
  "scripts": {
    "runtime": "node tools/install-runtime.cjs",
    "build": "esbuild src/renderer.js --bundle --outfile=ui/app.js --format=esm --platform=browser",
    "start": "npm run build && electron .",
    "test": "node --test test/*.test.cjs",
    "pack": "npm run build && electron-builder --win dir --config builder.cjs"
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@novnc/novnc": "^1.6.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "ssh2": "^1.17.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^42.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0"
  }
}
